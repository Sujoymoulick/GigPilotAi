# Database (Supabase)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# AI Provider Keys (Optional: fallbacks will run if empty)
OPENAI_API_KEY=sk-proj-...
GEMINI_API_KEY=AIzaSy...
CLAUDE_API_KEY=sk-ant-...
GROQ_API_KEY=gsk_...
OPENROUTER_API_KEY=sk-or-...

# Authentication (Google OAuth)
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
JWT_SECRET=gigpilot-secret-jwt-key-2026

# Payments (Razorpay)
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=your-razorpay-secret

# Storage & Assets
CLOUDFLARE_R2_BUCKET=gigpilot-assets
CLOUDFLARE_R2_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_R2_ACCESS_KEY_ID=your-r2-access-key-id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
CLOUDINARY_URL=cloudinary://...

# Emails (Resend)
RESEND_API_KEY=re_...

# Caching (Upstash Redis)
REDIS_URL=rediss://default:password@endpoint:port
REDIS_TOKEN=your-upstash-redis-rest-token

# Server & Routing
PORT=3000
FRONTEND_URL=http://localhost:3000,http://localhost:4321,http://127.0.0.1:4321,http://127.0.0.1:3000
