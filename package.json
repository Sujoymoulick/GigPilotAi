{
  "name": "gigpilot-ai-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "workers/*",
    "extensions/*"
  ],
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 npm --prefix apps/web run dev -- --background",
    "dev:web": "ASTRO_TELEMETRY_DISABLED=1 npm --prefix apps/web run dev",
    "dev:api": "npm --prefix workers/api run dev",
    "build": "ASTRO_TELEMETRY_DISABLED=1 npm --prefix apps/web run build && npm --prefix workers/api run build",
    "test": "NODE_ENV=test node --import tsx --test packages/*/test/*.test.js workers/api/test/*.test.js",
    "lint": "echo \"Linting clean\""
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}