---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import { Bot, Mail, ArrowRight, Eye, EyeOff } from 'lucide-react';
import LogoWhite from '../assets/LogoWhite.png';
import logoBlack from '../assets/logoblack.png';

const supabaseUrl = import.meta.env.SUPABASE_URL || process.env.SUPABASE_URL || 'https://mock.supabase.co';
const supabaseAnonKey = import.meta.env.SUPABASE_ANON_KEY || process.env.SUPABASE_ANON_KEY || 'mock-key';
---

<Layout title="Sign In / Sign Up - GigPilot AI">
  <style>
    html, body { background-color: #FAF9F6 !important; }
  </style>

  <div class="min-h-screen flex overflow-hidden font-sans relative bg-[#FAF9F6]">

    <!-- LEFT PANEL: Video Column (Desktop only) -->
    <div class="hidden md:flex md:w-[45%] lg:w-[42%] relative flex-col justify-between overflow-hidden h-screen select-none">
      <!-- Background video -->
      <video
        id="login-video"
        autoplay
        loop
        muted
        playsinline
        class="absolute inset-0 w-full h-full object-cover"
        src="/loginintro.mp4"
      ></video>

      <!-- Gradient overlays for readability -->
      <div class="absolute inset-0 bg-gradient-to-t from-slate-900/80 via-slate-900/20 to-slate-900/50 pointer-events-none"></div>
      <div class="absolute inset-0 bg-gradient-to-r from-transparent to-black/10 pointer-events-none"></div>

      <!-- Top: Logo + Back link -->
      <div class="relative z-10 flex items-center justify-between p-10">
        <a href="/" class="flex items-center gap-2.5 group">
          <div class="w-9 h-9 flex items-center justify-center group-hover:scale-110 transition-transform duration-300">
            <Image src={LogoWhite} alt="GigPilot Logo" width={36} height={36} class="w-9 h-9 object-contain" />
          </div>
          <span class="font-extrabold text-sm tracking-tight text-white flex items-center gap-1.5">
            GigPilot <span class="text-[9px] px-1.5 py-0.5 rounded bg-white/15 text-white font-semibold border border-white/25">AI</span>
          </span>
        </a>

        <a
          href="/"
          class="inline-flex items-center gap-1.5 px-4 py-1.5 text-[11px] font-semibold text-white rounded-full bg-white/10 hover:bg-white/20 border border-white/20 transition-all backdrop-blur-md"
        >
          Back to website <ArrowRight class="w-3 h-3" />
        </a>
      </div>

      <!-- Bottom: Tagline + indicators -->
      <div class="relative z-10 p-10 space-y-4">
        <div class="inline-flex items-center px-3 py-1 rounded-full bg-green-500/20 border border-green-400/30 text-green-300 text-[10px] font-bold tracking-wider uppercase mb-2">
          The AI OS for Fiverr Freelancers
        </div>
        <h3 id="carousel-title" class="text-2xl font-bold text-white leading-snug tracking-tight max-w-[300px] min-h-[4.5rem] transition-all duration-300">
          Scale Your Fiverr Business to Top Rated Seller
        </h3>
        <div class="flex gap-1.5" id="carousel-indicators">
          <span class="w-6 h-1 rounded bg-white transition-all duration-300 cursor-pointer hover:bg-white/65" data-index="0"></span>
          <span class="w-4 h-1 rounded bg-white/30 transition-all duration-300 cursor-pointer hover:bg-white/65" data-index="1"></span>
          <span class="w-4 h-1 rounded bg-white/30 transition-all duration-300 cursor-pointer hover:bg-white/65" data-index="2"></span>
        </div>
      </div>
    </div>

    <!-- RIGHT PANEL: Authentication Form -->
    <div class="w-full md:w-[55%] lg:w-[58%] min-h-screen bg-white flex flex-col justify-center px-6 sm:px-12 md:px-16 lg:px-20 xl:px-28 relative border-l border-slate-100">
      <!-- Subtle background decoration -->
      <div class="absolute top-0 right-0 w-[400px] h-[400px] bg-green-50 rounded-full blur-[120px] opacity-60 pointer-events-none -translate-y-1/2 translate-x-1/2"></div>
      <div class="absolute bottom-0 left-0 w-[300px] h-[300px] bg-teal-50 rounded-full blur-[100px] opacity-50 pointer-events-none translate-y-1/2 -translate-x-1/2"></div>

      <div id="auth-config" data-url={supabaseUrl} data-key={supabaseAnonKey} class="hidden"></div>

      <!-- Mobile Logo -->
      <div class="md:hidden flex items-center justify-between mb-10 relative z-10">
        <a href="/" class="flex items-center gap-2.5">
          <Image src={logoBlack} alt="GigPilot Logo" width={32} height={32} class="w-8 h-8 object-contain" />
          <span class="font-extrabold text-sm tracking-tight text-slate-900 flex items-center gap-1.5">
            GigPilot <span class="text-[9px] px-1.5 py-0.5 rounded bg-green-500/10 text-slate-900 font-semibold border border-green-500/20">AI</span>
          </span>
        </a>
        <a href="/" class="inline-flex items-center gap-1 px-3 py-1 text-[11px] font-semibold text-slate-600 hover:text-slate-900 rounded-full bg-slate-100 border border-slate-200 transition-all">
          Website <ArrowRight class="w-3 h-3" />
        </a>
      </div>

      <div class="max-w-[420px] w-full mx-auto relative z-10">
        <div id="auth-panel-container" class="relative w-full transition-all duration-300">

          <!-- LOGIN FORM WRAPPER -->
          <div id="login-form-wrapper" class="relative w-full opacity-100 translate-x-0 pointer-events-auto transition-all duration-500 ease-in-out transform">
            <div class="space-y-2 mb-8">
              <h2 class="text-3xl sm:text-4xl font-bold text-slate-900 tracking-tight">Welcome back</h2>
              <p class="text-sm text-slate-500">
                New to GigPilot? <a href="#" id="switch-to-signup" class="text-green-700 hover:text-green-600 font-semibold underline underline-offset-4 decoration-green-500/30 transition-colors">Create an account</a>
              </p>
            </div>

            <form class="space-y-4" id="loginForm">
              <!-- Email -->
              <div class="relative">
                <input
                  id="email"
                  name="email"
                  type="email"
                  required
                  placeholder="Email address"
                  class="block w-full h-[52px] px-4 bg-white border border-slate-200 hover:border-slate-300 rounded-xl text-sm text-slate-900 placeholder-slate-400 focus:outline-none focus:border-green-500 focus:ring-2 focus:ring-green-500/15 transition-all"
                />
              </div>

              <!-- Password -->
              <div class="relative">
                <input
                  id="password"
                  name="password"
                  type="password"
                  required
                  placeholder="Enter your password"
                  class="block w-full h-[52px] pl-4 pr-12 bg-white border border-slate-200 hover:border-slate-300 rounded-xl text-sm text-slate-900 placeholder-slate-400 focus:outline-none focus:border-green-500 focus:ring-2 focus:ring-green-500/15 transition-all"
                />
                <button id="togglePassword" type="button" class="absolute inset-y-0 right-0 pr-4 flex items-center text-slate-400 hover:text-slate-600 transition-colors">
                  <Eye id="eyeIcon" class="w-5 h-5" />
                  <EyeOff id="eyeOffIcon" class="w-5 h-5 hidden" />
                </button>
              </div>

              <!-- Remember + Forgot -->
              <div class="flex items-center justify-between text-xs pt-1">
                <label class="flex items-center cursor-pointer select-none gap-2">
                  <input id="remember-me" name="remember-me" type="checkbox" class="sr-only peer" />
                  <div class="w-4 h-4 rounded border border-slate-200 bg-white peer-checked:bg-green-600 peer-checked:border-green-600 flex items-center justify-center transition-all">
                    <svg class="w-2.5 h-2.5 text-white opacity-0 peer-checked:opacity-100 transition-opacity" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                    </svg>
                  </div>
                  <span class="text-slate-500 peer-checked:text-slate-700">Remember me</span>
                </label>
                <a href="#" class="font-semibold text-green-700 hover:text-green-600 transition-colors">Forgot password?</a>
              </div>

              <!-- Submit -->
              <button
                type="submit"
                class="w-full h-[50px] rounded-xl bg-green-600 hover:bg-green-500 text-white font-semibold text-sm transition-all shadow-lg shadow-green-500/20 hover:shadow-green-500/30 active:scale-[0.99] mt-4 flex items-center justify-center gap-2"
              >
                Sign In <ArrowRight class="w-4 h-4" />
              </button>
            </form>

            <!-- Divider -->
            <div class="mt-8">
              <div class="relative flex items-center justify-center mb-6">
                <div class="absolute inset-0 flex items-center">
                  <div class="w-full border-t border-slate-100"></div>
                </div>
                <span class="relative px-4 bg-white text-[11px] text-slate-400 font-semibold tracking-wide uppercase">Or continue with</span>
              </div>
              <div class="grid grid-cols-2 gap-3">
                <button id="googleLoginBtn" class="w-full h-[48px] rounded-xl bg-white border border-slate-200 hover:border-slate-300 hover:bg-slate-50 text-slate-700 font-semibold text-xs flex items-center justify-center gap-2.5 transition-all shadow-sm">
                  <svg class="w-4 h-4" viewBox="0 0 24 24">
                    <path fill="#EA4335" d="M12.24 10.285V14.4h6.887c-.648 2.41-2.519 4.114-5.136 4.114A5.53 5.53 0 0 1 8.4 12.99a5.53 5.53 0 0 1 5.59-5.53c2.44 0 4.135 1.05 4.887 1.77l3.253-3.253C20.177 4.09 17.382 2.76 13.99 2.76A9.23 9.23 0 0 0 4.76 12a9.23 9.23 0 0 0 9.23 9.24c5.38 0 8.97-3.78 8.97-9.12 0-.62-.05-1.22-.17-1.835h-10.55Z"/>
                  </svg>
                  Google
                </button>
                <button id="magicLinkBtn" class="w-full h-[48px] rounded-xl bg-white border border-slate-200 hover:border-slate-300 hover:bg-slate-50 text-slate-700 font-semibold text-xs flex items-center justify-center gap-2.5 transition-all shadow-sm">
                  <Mail class="w-4 h-4 text-green-600" />
                  Magic Link
                </button>
              </div>
            </div>
          </div>

          <!-- SIGNUP FORM WRAPPER -->
          <div id="signup-form-wrapper" class="absolute inset-x-0 top-0 opacity-0 translate-x-12 pointer-events-none transition-all duration-500 ease-in-out transform">
            <div class="space-y-2 mb-8">
              <h2 class="text-3xl sm:text-4xl font-bold text-slate-900 tracking-tight">Create an account</h2>
              <p class="text-sm text-slate-500">
                Already have an account? <a href="#" id="switch-to-login" class="text-green-700 hover:text-green-600 font-semibold underline underline-offset-4 decoration-green-500/30 transition-colors">Log in</a>
              </p>
            </div>

            <form class="space-y-4" id="signupForm">
              <!-- Name row -->
              <div class="grid grid-cols-2 gap-3">
                <input id="signup-first-name" name="firstName" type="text" required placeholder="First name"
                  class="block w-full h-[52px] px-4 bg-white border border-slate-200 hover:border-slate-300 rounded-xl text-sm text-slate-900 placeholder-slate-400 focus:outline-none focus:border-green-500 focus:ring-2 focus:ring-green-500/15 transition-all" />
                <input id="signup-last-name" name="lastName" type="text" required placeholder="Last name"
                  class="block w-full h-[52px] px-4 bg-white border border-slate-200 hover:border-slate-300 rounded-xl text-sm text-slate-900 placeholder-slate-400 focus:outline-none focus:border-green-500 focus:ring-2 focus:ring-green-500/15 transition-all" />
              </div>

              <!-- Email -->
              <input id="signup-email" name="email" type="email" required placeholder="Email address"
                class="block w-full h-[52px] px-4 bg-white border border-slate-200 hover:border-slate-300 rounded-xl text-sm text-slate-900 placeholder-slate-400 focus:outline-none focus:border-green-500 focus:ring-2 focus:ring-green-500/15 transition-all" />

              <!-- Password -->
              <div class="relative">
                <input id="signup-password" name="password" type="password" required placeholder="Create a password"
                  class="block w-full h-[52px] pl-4 pr-12 bg-white border border-slate-200 hover:border-slate-300 rounded-xl text-sm text-slate-900 placeholder-slate-400 focus:outline-none focus:border-green-500 focus:ring-2 focus:ring-green-500/15 transition-all" />
                <button id="toggleSignupPassword" type="button" class="absolute inset-y-0 right-0 pr-4 flex items-center text-slate-400 hover:text-slate-600 transition-colors">
                  <Eye id="signupEyeIcon" class="w-5 h-5" />
                  <EyeOff id="signupEyeOffIcon" class="w-5 h-5 hidden" />
                </button>
              </div>

              <!-- Terms -->
              <label class="flex items-start cursor-pointer select-none gap-2 text-xs pt-1">
                <input id="signup-terms" name="terms" type="checkbox" required class="sr-only peer" />
                <div class="w-4 h-4 rounded border border-slate-200 bg-white peer-checked:bg-green-600 peer-checked:border-green-600 flex items-center justify-center transition-all mt-0.5 flex-shrink-0">
                  <svg class="w-2.5 h-2.5 text-white opacity-0 peer-checked:opacity-100 transition-opacity" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                  </svg>
                </div>
                <span class="text-slate-500 peer-checked:text-slate-700 leading-tight">
                  I agree to the <a href="#" class="text-green-700 hover:underline">Terms & Conditions</a>
                </span>
              </label>

              <!-- Submit -->
              <button type="submit"
                class="w-full h-[50px] rounded-xl bg-green-600 hover:bg-green-500 text-white font-semibold text-sm transition-all shadow-lg shadow-green-500/20 hover:shadow-green-500/30 active:scale-[0.99] mt-4 flex items-center justify-center gap-2">
                Create Account <ArrowRight class="w-4 h-4" />
              </button>
            </form>

            <!-- Divider -->
            <div class="mt-8">
              <div class="relative flex items-center justify-center mb-6">
                <div class="absolute inset-0 flex items-center">
                  <div class="w-full border-t border-slate-100"></div>
                </div>
                <span class="relative px-4 bg-white text-[11px] text-slate-400 font-semibold tracking-wide uppercase">Or register with</span>
              </div>
              <div class="grid grid-cols-2 gap-3">
                <button id="googleSignupBtn" type="button" class="w-full h-[48px] rounded-xl bg-white border border-slate-200 hover:border-slate-300 hover:bg-slate-50 text-slate-700 font-semibold text-xs flex items-center justify-center gap-2.5 transition-all shadow-sm">
                  <svg class="w-4 h-4" viewBox="0 0 24 24">
                    <path fill="#EA4335" d="M12.24 10.285V14.4h6.887c-.648 2.41-2.519 4.114-5.136 4.114A5.53 5.53 0 0 1 8.4 12.99a5.53 5.53 0 0 1 5.59-5.53c2.44 0 4.135 1.05 4.887 1.77l3.253-3.253C20.177 4.09 17.382 2.76 13.99 2.76A9.23 9.23 0 0 0 4.76 12a9.23 9.23 0 0 0 9.23 9.24c5.38 0 8.97-3.78 8.97-9.12 0-.62-.05-1.22-.17-1.835h-10.55Z"/>
                  </svg>
                  Google
                </button>
                <button id="magicLinkSignupBtn" type="button" class="w-full h-[48px] rounded-xl bg-white border border-slate-200 hover:border-slate-300 hover:bg-slate-50 text-slate-700 font-semibold text-xs flex items-center justify-center gap-2.5 transition-all shadow-sm">
                  <Mail class="w-4 h-4 text-green-600" />
                  Magic Link
                </button>
              </div>
            </div>
          </div>

        </div>
      </div>
    </div>
  </div>

  <script>
    import { createClient } from '@supabase/supabase-js';

    // Store interval globally on window to avoid memory leaks/multiple intervals running
    declare global {
      interface Window {
        carouselInterval?: number;
      }
    }

    function initAuthPage() {
      // Retrieve config from DOM
      const configEl = document.getElementById('auth-config');
      const supabaseUrl = configEl?.getAttribute('data-url') || 'https://mock.supabase.co';
      const supabaseAnonKey = configEl?.getAttribute('data-key') || 'mock-key';

      // Initialize Supabase Client
      const supabase = createClient(supabaseUrl, supabaseAnonKey);

      const loginForm = document.getElementById('loginForm') as HTMLFormElement;
      const signupForm = document.getElementById('signupForm') as HTMLFormElement;
      
      // Auth Trigger buttons
      const googleBtn = document.getElementById('googleLoginBtn');
      const googleSignupBtn = document.getElementById('googleSignupBtn');
      const magicLinkBtn = document.getElementById('magicLinkBtn');
      const magicLinkSignupBtn = document.getElementById('magicLinkSignupBtn');

      // Switch buttons
      const switchToSignup = document.getElementById('switch-to-signup');
      const switchToLogin = document.getElementById('switch-to-login');

      const loginFormWrapper = document.getElementById('login-form-wrapper');
      const signupFormWrapper = document.getElementById('signup-form-wrapper');

      const API_URL = import.meta.env.PUBLIC_API_URL || 'http://localhost:3000'; // Target API port

      // Switch between Login and Signup with animation
      function setAuthMode(mode: 'login' | 'signup') {
        if (mode === 'signup') {
          // Prepare login to slide away
          loginFormWrapper?.classList.remove('relative', 'opacity-100', 'translate-x-0', 'pointer-events-auto');
          loginFormWrapper?.classList.add('absolute', 'opacity-0', '-translate-x-12', 'pointer-events-none');
          
          // Prepare signup to slide in
          signupFormWrapper?.classList.remove('absolute', 'opacity-0', 'translate-x-12', 'pointer-events-none');
          signupFormWrapper?.classList.add('relative', 'opacity-100', 'translate-x-0', 'pointer-events-auto');
        } else {
          // Prepare login to slide back in
          loginFormWrapper?.classList.remove('absolute', 'opacity-0', '-translate-x-12', 'pointer-events-none');
          loginFormWrapper?.classList.add('relative', 'opacity-100', 'translate-x-0', 'pointer-events-auto');
          
          // Prepare signup to slide out
          signupFormWrapper?.classList.remove('relative', 'opacity-100', 'translate-x-0', 'pointer-events-auto');
          signupFormWrapper?.classList.add('absolute', 'opacity-0', 'translate-x-12', 'pointer-events-none');
        }
      }

      switchToSignup?.addEventListener('click', (e) => {
        e.preventDefault();
        setAuthMode('signup');
      });

      switchToLogin?.addEventListener('click', (e) => {
        e.preventDefault();
        setAuthMode('login');
      });

      // Submissions
      loginForm?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const email = (document.getElementById('email') as HTMLInputElement).value;
        const password = (document.getElementById('password') as HTMLInputElement).value;
        const isMockMode = supabaseUrl.includes('mock.supabase.co') || supabaseAnonKey === 'mock-key';

        if (isMockMode) {
          // Fallback for demo/testing mode
          localStorage.setItem('gp_token', 'mock-session-token');
          localStorage.setItem('gp_user', JSON.stringify({ email, role: 'Pro', fullName: email.split('@')[0] }));
          window.location.href = '/dashboard';
          return;
        }

        try {
          const { data, error } = await supabase.auth.signInWithPassword({ email, password });
          if (error) throw error;

          if (data.session) {
            const userMetadata = data.session.user.user_metadata || {};
            const userObj = {
              id: data.session.user.id,
              email: data.session.user.email,
              fullName: userMetadata.full_name || email.split('@')[0],
              role: 'Pro'
            };
            localStorage.setItem('gp_token', data.session.access_token);
            localStorage.setItem('gp_user', JSON.stringify(userObj));

            // Sync user with backend
            try {
              await fetch(`${API_URL}/api/auth/login`, {
                method: 'POST',
                headers: { 
                  'Content-Type': 'application/json',
                  'Authorization': `Bearer ${data.session.access_token}`
                },
                body: JSON.stringify({ email, fullName: userObj.fullName })
              });
            } catch (syncErr) {
              console.warn('Backend sync failed', syncErr);
            }

            window.location.href = '/dashboard';
          } else {
            alert('Login failed: Session not created');
          }
        } catch (err: any) {
          console.error('Login error', err);
          alert(err.message || 'Authentication failed');
        }
      });

      signupForm?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const firstName = (document.getElementById('signup-first-name') as HTMLInputElement).value;
        const lastName = (document.getElementById('signup-last-name') as HTMLInputElement).value;
        const email = (document.getElementById('signup-email') as HTMLInputElement).value;
        const password = (document.getElementById('signup-password') as HTMLInputElement).value;
        const termsChecked = (document.getElementById('signup-terms') as HTMLInputElement).checked;

        if (!termsChecked) {
          alert('You must agree to the Terms & Conditions');
          return;
        }

        const fullName = `${firstName} ${lastName}`.trim();
        const isMockMode = supabaseUrl.includes('mock.supabase.co') || supabaseAnonKey === 'mock-key';

        if (isMockMode) {
          // Fallback for demo
          localStorage.setItem('gp_token', 'mock-session-token');
          localStorage.setItem('gp_user', JSON.stringify({ email, fullName, role: 'Pro' }));
          window.location.href = '/dashboard';
          return;
        }

        try {
          const { data, error } = await supabase.auth.signUp({
            email,
            password,
            options: {
              emailRedirectTo: `${window.location.origin}/auth/callback`,
              data: {
                full_name: fullName,
              }
            }
          });

          if (error) throw error;

          if (data.session) {
            const userObj = {
              id: data.session.user.id,
              email: data.session.user.email,
              fullName: fullName,
              role: 'Pro'
            };
            localStorage.setItem('gp_token', data.session.access_token);
            localStorage.setItem('gp_user', JSON.stringify(userObj));

            // Sync with API
            try {
              await fetch(`${API_URL}/api/auth/login`, {
                method: 'POST',
                headers: { 
                  'Content-Type': 'application/json',
                  'Authorization': `Bearer ${data.session.access_token}`
                },
                body: JSON.stringify({ email, fullName })
              });
            } catch (syncErr) {
              console.warn('Backend sync failed', syncErr);
            }

            window.location.href = '/dashboard';
          } else {
            alert('Sign up successful! Please check your email to confirm your account.');
          }
        } catch (err: any) {
          console.error('Signup error', err);
          alert(err.message || 'Registration failed');
        }
      });

      // Google / Magic Link Integration
      const handleGoogleLogin = async () => {
        const isMockMode = supabaseUrl.includes('mock.supabase.co') || supabaseAnonKey === 'mock-key';
        if (isMockMode) {
          localStorage.setItem('gp_token', 'mock-session-token');
          localStorage.setItem('gp_user', JSON.stringify({ email: 'alex@gigpilot.ai', fullName: 'Alex Rivera', role: 'Pro' }));
          window.location.href = '/dashboard';
          return;
        }

        try {
          const { error } = await supabase.auth.signInWithOAuth({
            provider: 'google',
            options: {
              redirectTo: `${window.location.origin}/auth/callback`,
              queryParams: {
                access_type: 'offline',
                prompt: 'consent',
              }
            }
          });
          if (error) throw error;
        } catch (err: any) {
          console.error('Google OAuth error', err);
          alert(err.message || 'Failed to initialize Google Login');
        }
      };

      googleBtn?.addEventListener('click', handleGoogleLogin);
      googleSignupBtn?.addEventListener('click', handleGoogleLogin);

      const handleMagicLink = async (emailInputId: string) => {
        const email = (document.getElementById(emailInputId) as HTMLInputElement).value;
        if (!email) {
          alert('Please enter an email address first');
          return;
        }
        const isMockMode = supabaseUrl.includes('mock.supabase.co') || supabaseAnonKey === 'mock-key';
        if (isMockMode) {
          alert('Simulating magic link: Check console or click redirect!');
          console.log('Mock Magic Link URL: http://localhost:4321/dashboard');
          localStorage.setItem('gp_token', 'mock-session-token');
          localStorage.setItem('gp_user', JSON.stringify({ email, fullName: email.split('@')[0], role: 'Pro' }));
          window.location.href = '/dashboard';
          return;
        }

        try {
          const { error } = await supabase.auth.signInWithOtp({
            email,
            options: {
              emailRedirectTo: `${window.location.origin}/auth/callback`
            }
          });
          if (error) throw error;
          alert('Magic link sent! Please check your email.');
        } catch (err: any) {
          console.error('Magic link error', err);
          alert(err.message || 'Failed to send magic link');
        }
      };

      magicLinkBtn?.addEventListener('click', () => handleMagicLink('email'));
      magicLinkSignupBtn?.addEventListener('click', () => handleMagicLink('signup-email'));

      // Password visibility toggle (Login)
      const togglePasswordBtn = document.getElementById('togglePassword');
      const passwordInput = document.getElementById('password') as HTMLInputElement;
      const eyeIcon = document.getElementById('eyeIcon');
      const eyeOffIcon = document.getElementById('eyeOffIcon');

      togglePasswordBtn?.addEventListener('click', () => {
        if (passwordInput.type === 'password') {
          passwordInput.type = 'text';
          eyeIcon?.classList.add('hidden');
          eyeOffIcon?.classList.remove('hidden');
        } else {
          passwordInput.type = 'password';
          eyeIcon?.classList.remove('hidden');
          eyeOffIcon?.classList.add('hidden');
        }
      });

      // Password visibility toggle (Signup)
      const toggleSignupPasswordBtn = document.getElementById('toggleSignupPassword');
      const signupPasswordInput = document.getElementById('signup-password') as HTMLInputElement;
      const signupEyeIcon = document.getElementById('signupEyeIcon');
      const signupEyeOffIcon = document.getElementById('signupEyeOffIcon');

      toggleSignupPasswordBtn?.addEventListener('click', () => {
        if (signupPasswordInput.type === 'password') {
          signupPasswordInput.type = 'text';
          signupEyeIcon?.classList.add('hidden');
          signupEyeOffIcon?.classList.remove('hidden');
        } else {
          signupPasswordInput.type = 'password';
          signupEyeIcon?.classList.remove('hidden');
          signupEyeOffIcon?.classList.add('hidden');
        }
      });

      // Left column carousel logic
      const titles = [
        "Scale Your Fiverr Business to Top Rated Seller",
        "Optimize Gig SEO & Find Profitable Keywords",
        "Write Winning Proposals & Structure Pricing"
      ];

      const titleEl = document.getElementById('carousel-title');
      const indicators = document.querySelectorAll('#carousel-indicators span');

      let currentSlide = 0;

      function changeToSlide(index: number) {
        if (!titleEl) return;
        currentSlide = index;

        // Premium fade-slide animation
        // 1. Slide up and fade out
        titleEl.style.transition = 'opacity 0.4s cubic-bezier(0.16, 1, 0.3, 1), transform 0.4s cubic-bezier(0.16, 1, 0.3, 1)';
        titleEl.style.opacity = '0';
        titleEl.style.transform = 'translateY(-12px)';
        
        setTimeout(() => {
          titleEl.textContent = titles[currentSlide];
          
          // 2. Prepare entry position instantly
          titleEl.style.transition = 'none';
          titleEl.style.transform = 'translateY(12px)';
          titleEl.style.opacity = '0';
          
          // Force layout reflow
          titleEl.offsetHeight;
          
          // 3. Slide in and fade in
          titleEl.style.transition = 'opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1), transform 0.6s cubic-bezier(0.16, 1, 0.3, 1)';
          titleEl.style.opacity = '1';
          titleEl.style.transform = 'translateY(0)';
          
          // Update active indicators
          indicators.forEach((indicator, idx) => {
            if (idx === currentSlide) {
              indicator.className = "w-6 h-1 rounded bg-white transition-all duration-300 cursor-pointer hover:bg-white/65";
            } else {
              indicator.className = "w-4 h-1 rounded bg-white/30 transition-all duration-300 cursor-pointer hover:bg-white/65";
            }
          });
        }, 400);
      }

      function nextSlide() {
        const nextIdx = (currentSlide + 1) % titles.length;
        changeToSlide(nextIdx);
      }

      // Add click events to indicators
      indicators.forEach((indicator, idx) => {
        indicator.addEventListener('click', () => {
          if (currentSlide === idx) return;
          // Restart timer on user interaction to avoid sudden jumps right after click
          if (window.carouselInterval) {
            clearInterval(window.carouselInterval);
          }
          changeToSlide(idx);
          window.carouselInterval = window.setInterval(nextSlide, 2000);
        });
      });

      // Initial transition setup
      if (titleEl) {
        titleEl.style.transition = 'opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1), transform 0.6s cubic-bezier(0.16, 1, 0.3, 1)';
      }

      // Clear any existing interval to prevent leaks
      if (window.carouselInterval) {
        clearInterval(window.carouselInterval);
      }

      // Start the auto-rotation carousel
      window.carouselInterval = window.setInterval(nextSlide, 2000);

      // Ensure video plays correctly after client-side router transition
      const videoEl = document.getElementById('login-video') as HTMLVideoElement;
      if (videoEl) {
        videoEl.load();
        videoEl.play().catch(err => {
          console.warn("Video autoplay blocked or failed: ", err);
        });
      }
    }

    // Set up listeners for page transitions via ClientRouter
    document.addEventListener('astro:page-load', initAuthPage);

    // Initial setup in case of direct entry or non-client router load
    initAuthPage();
  </script>
</Layout>
