---
import Layout from '../layouts/Layout.astro';
import { Bot, Mail, ArrowRight, Eye, EyeOff } from 'lucide-react';

const supabaseUrl = import.meta.env.SUPABASE_URL || process.env.SUPABASE_URL || 'https://mock.supabase.co';
const supabaseAnonKey = import.meta.env.SUPABASE_ANON_KEY || process.env.SUPABASE_ANON_KEY || 'mock-key';
---

<Layout title="Sign In / Sign Up - GigPilot AI">
  <div class="min-h-screen bg-[#0B0A11] flex overflow-hidden font-sans relative">
    
    <!-- LEFT PANEL: Brand Image Column (Desktop only) -->
    <div class="hidden md:flex md:w-[42%] lg:w-[40%] xl:w-[35%] relative flex-col justify-between p-12 overflow-hidden h-screen select-none border-r border-[#1D1B26]">
      <!-- Background Image with beautiful dusk sand dune -->
      <div class="absolute inset-0">
        <img 
          src="/login_bg.jpg" 
          alt="Desert at twilight" 
          class="w-full h-full object-cover brightness-[0.7] contrast-[1.05]"
        />
        <!-- Deep rich purple gradient overlay -->
        <div class="absolute inset-0 bg-gradient-to-t from-[#0B0A11] via-[#0B0A11]/30 to-[#0B0A11]/85 mix-blend-multiply"></div>
        <div class="absolute inset-0 bg-gradient-to-tr from-[#1E1233]/45 via-transparent to-transparent mix-blend-color-dodge"></div>
      </div>
      
      <!-- Top Section -->
      <div class="relative z-10 flex items-center justify-between">
        <!-- Logo -->
        <a href="/" class="flex items-center gap-2.5">
          <div class="w-8.5 h-8.5 rounded-xl bg-gradient-to-tr from-[#059669] to-[#0d9488] flex items-center justify-center shadow-lg shadow-emerald-500/25">
            <Bot class="w-5 h-5 text-white" />
          </div>
          <span class="font-extrabold text-sm tracking-tight text-white flex items-center gap-1">
            GigPilot <span class="text-[9px] px-1.5 py-0.5 rounded bg-emerald-500/20 text-emerald-400 font-semibold border border-emerald-500/30">AI</span>
          </span>
        </a>
        
        <!-- Back to Website capsule -->
        <a 
          href="/" 
          class="inline-flex items-center gap-1.5 px-4 py-1.5 text-[11px] font-semibold text-slate-200 hover:text-white rounded-full bg-white/5 hover:bg-white/10 border border-white/10 hover:border-white/20 transition-all backdrop-blur-md"
        >
          Back to website <ArrowRight class="w-3 h-3" />
        </a>
      </div>
      
      <!-- Bottom Section -->
      <div class="relative z-10 space-y-5">
        <h3 id="carousel-title" class="text-2xl font-bold text-white leading-snug tracking-tight max-w-[280px] min-h-[4.5rem]">
          Scale Your Fiverr Business to Top Rated Seller
        </h3>
        
        <!-- Three-bar active indicator -->
        <div class="flex gap-1.5" id="carousel-indicators">
          <span class="w-6 h-1 rounded bg-white transition-all duration-300" data-index="0"></span>
          <span class="w-4 h-1 rounded bg-white/30 transition-all duration-300" data-index="1"></span>
          <span class="w-4 h-1 rounded bg-white/30 transition-all duration-300" data-index="2"></span>
        </div>
      </div>
    </div>
    
    <!-- RIGHT PANEL: Authentication Form Column -->
    <div class="w-full md:w-[58%] lg:w-[60%] xl:w-[65%] min-h-screen bg-[#110F18] flex flex-col justify-center px-4 sm:px-12 md:px-16 lg:px-24 xl:px-32 relative z-10">
      <div id="auth-config" data-url={supabaseUrl} data-key={supabaseAnonKey} class="hidden"></div>
      <!-- Glow blobs -->
      <div class="absolute top-[10%] right-[10%] w-[380px] h-[380px] rounded-full bg-purple-600/10 blur-[110px] pointer-events-none" />
      <div class="absolute bottom-[10%] left-[10%] w-[320px] h-[320px] rounded-full bg-[#059669]/5 blur-[120px] pointer-events-none" />

      <div class="max-w-[420px] w-full mx-auto relative z-10">
        <!-- Logo for mobile/tablet screens only -->
        <div class="md:hidden flex items-center justify-between mb-10">
          <a href="/" class="flex items-center gap-2.5">
            <div class="w-8.5 h-8.5 rounded-xl bg-gradient-to-tr from-[#059669] to-[#0d9488] flex items-center justify-center shadow-lg shadow-emerald-500/25">
              <Bot class="w-5 h-5 text-white" />
            </div>
            <span class="font-extrabold text-sm tracking-tight text-white flex items-center gap-1">
              GigPilot <span class="text-[9px] px-1.5 py-0.5 rounded bg-emerald-500/20 text-emerald-400 font-semibold border border-emerald-500/30">AI</span>
            </span>
          </a>
          <a 
            href="/" 
            class="inline-flex items-center gap-1 px-3 py-1 text-[11px] font-semibold text-slate-400 hover:text-white rounded-full bg-slate-900 border border-slate-800 transition-all"
          >
            Website <ArrowRight class="w-3 h-3" />
          </a>
        </div>

        <div id="auth-panel-container" class="relative w-full transition-all duration-300">
          
          <!-- LOGIN FORM WRAPPER -->
          <div id="login-form-wrapper" class="relative w-full opacity-100 translate-x-0 pointer-events-auto transition-all duration-500 ease-in-out transform">
            <!-- Header -->
            <div class="space-y-2">
              <h2 class="text-3xl sm:text-4xl font-semibold text-white tracking-tight">Sign in to account</h2>
              <p class="text-sm text-slate-400">
                New to GigPilot? <a href="#" id="switch-to-signup" class="text-indigo-400 hover:text-indigo-300 font-medium underline underline-offset-4 decoration-indigo-400/30 transition-colors">Create an account</a>
              </p>
            </div>

            <!-- Form -->
            <form class="space-y-4 mt-8" id="loginForm">
              <!-- Email Input Group -->
              <div class="relative">
                <input
                  id="email"
                  name="email"
                  type="email"
                  required
                  placeholder="Email address"
                  class="block w-full h-[52px] px-4 bg-[#181622]/80 border border-[#2D2A3A] hover:border-[#3D3A4D] rounded-xl text-sm text-white placeholder-slate-500 focus:outline-none focus:border-indigo-500/80 focus:ring-1 focus:ring-indigo-500/30 transition-all"
                />
              </div>

              <!-- Password Input Group -->
              <div class="relative">
                <input
                  id="password"
                  name="password"
                  type="password"
                  required
                  placeholder="Enter your password"
                  class="block w-full h-[52px] pl-4 pr-12 bg-[#181622]/80 border border-[#2D2A3A] hover:border-[#3D3A4D] rounded-xl text-sm text-white placeholder-slate-500 focus:outline-none focus:border-indigo-500/80 focus:ring-1 focus:ring-indigo-500/30 transition-all"
                />
                <!-- Visibility Toggle Button -->
                <button
                  id="togglePassword"
                  type="button"
                  class="absolute inset-y-0 right-0 pr-4 flex items-center text-slate-500 hover:text-slate-300 transition-colors"
                >
                  <Eye id="eyeIcon" class="w-5 h-5" />
                  <EyeOff id="eyeOffIcon" class="w-5 h-5 hidden" />
                </button>
              </div>

              <!-- Remember me & Forgot Password -->
              <div class="flex items-center justify-between text-xs pt-1">
                <label class="flex items-center cursor-pointer select-none">
                  <input
                    id="remember-me"
                    name="remember-me"
                    type="checkbox"
                    class="sr-only peer"
                  />
                  <div class="w-4 h-4 rounded border border-[#2D2A3A] bg-[#181622] peer-checked:bg-indigo-600 peer-checked:border-indigo-600 flex items-center justify-center transition-all mr-2">
                    <svg class="w-2.5 h-2.5 text-white opacity-0 peer-checked:opacity-100 transition-opacity" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                    </svg>
                  </div>
                  <span class="text-slate-400 peer-checked:text-slate-300">Remember me</span>
                </label>
                <a href="#" class="font-medium text-indigo-400 hover:text-indigo-300 transition-colors">Forgot password?</a>
              </div>

              <!-- Submit Button -->
              <button
                type="submit"
                class="w-full h-[50px] rounded-xl bg-[#6C5DD3] hover:bg-[#5C4EB7] text-white font-semibold text-sm transition-all shadow-lg shadow-indigo-500/10 hover:shadow-indigo-500/20 active:scale-[0.99] mt-6 flex items-center justify-center gap-1.5"
              >
                Sign In
              </button>
            </form>

            <!-- Divider -->
            <div class="mt-8">
              <div class="relative flex items-center justify-center mb-6">
                <div class="absolute inset-0 flex items-center">
                  <div class="w-full border-t border-[#2D2A3A]"></div>
                </div>
                <span class="relative px-4 bg-[#110F18] text-[11px] text-slate-500 font-semibold tracking-wide uppercase">Or continue with</span>
              </div>

              <!-- Social Buttons -->
              <div class="grid grid-cols-2 gap-4">
                <button
                  id="googleLoginBtn"
                  class="w-full h-[50px] rounded-xl bg-transparent border border-[#2D2A3A] hover:bg-white/5 text-slate-200 hover:text-white font-semibold text-xs flex items-center justify-center gap-2.5 transition-all"
                >
                  <svg class="w-4 h-4" viewBox="0 0 24 24">
                    <path fill="#EA4335" d="M12.24 10.285V14.4h6.887c-.648 2.41-2.519 4.114-5.136 4.114A5.53 5.53 0 0 1 8.4 12.99a5.53 5.53 0 0 1 5.59-5.53c2.44 0 4.135 1.05 4.887 1.77l3.253-3.253C20.177 4.09 17.382 2.76 13.99 2.76A9.23 9.23 0 0 0 4.76 12a9.23 9.23 0 0 0 9.23 9.24c5.38 0 8.97-3.78 8.97-9.12 0-.62-.05-1.22-.17-1.835h-10.55Z"/>
                  </svg>
                  Google
                </button>
                <button
                  id="magicLinkBtn"
                  class="w-full h-[50px] rounded-xl bg-transparent border border-[#2D2A3A] hover:bg-white/5 text-slate-200 hover:text-white font-semibold text-xs flex items-center justify-center gap-2.5 transition-all"
                >
                  <Mail class="w-4 h-4 text-indigo-400" />
                  Magic Link
                </button>
              </div>
            </div>
          </div>

          <!-- SIGNUP FORM WRAPPER -->
          <div id="signup-form-wrapper" class="absolute inset-x-0 top-0 opacity-0 translate-x-12 pointer-events-none transition-all duration-500 ease-in-out transform">
            <!-- Header -->
            <div class="space-y-2">
              <h2 class="text-3xl sm:text-4xl font-semibold text-white tracking-tight">Create an account</h2>
              <p class="text-sm text-slate-400">
                Already have an account? <a href="#" id="switch-to-login" class="text-indigo-400 hover:text-indigo-300 font-medium underline underline-offset-4 decoration-indigo-400/30 transition-colors">Log in</a>
              </p>
            </div>

            <!-- Form -->
            <form class="space-y-4 mt-8" id="signupForm">
              
              <!-- First & Last Name side by side -->
              <div class="grid grid-cols-2 gap-4">
                <div class="relative">
                  <input
                    id="signup-first-name"
                    name="firstName"
                    type="text"
                    required
                    placeholder="First name"
                    class="block w-full h-[52px] px-4 bg-[#181622]/80 border border-[#2D2A3A] hover:border-[#3D3A4D] rounded-xl text-sm text-white placeholder-slate-500 focus:outline-none focus:border-indigo-500/80 focus:ring-1 focus:ring-indigo-500/30 transition-all"
                  />
                </div>
                <div class="relative">
                  <input
                    id="signup-last-name"
                    name="lastName"
                    type="text"
                    required
                    placeholder="Last name"
                    class="block w-full h-[52px] px-4 bg-[#181622]/80 border border-[#2D2A3A] hover:border-[#3D3A4D] rounded-xl text-sm text-white placeholder-slate-500 focus:outline-none focus:border-indigo-500/80 focus:ring-1 focus:ring-indigo-500/30 transition-all"
                  />
                </div>
              </div>

              <!-- Email Input Group -->
              <div class="relative">
                <input
                  id="signup-email"
                  name="email"
                  type="email"
                  required
                  placeholder="Email"
                  class="block w-full h-[52px] px-4 bg-[#181622]/80 border border-[#2D2A3A] hover:border-[#3D3A4D] rounded-xl text-sm text-white placeholder-slate-500 focus:outline-none focus:border-indigo-500/80 focus:ring-1 focus:ring-indigo-500/30 transition-all"
                />
              </div>

              <!-- Password Input Group -->
              <div class="relative">
                <input
                  id="signup-password"
                  name="password"
                  type="password"
                  required
                  placeholder="Enter your password"
                  class="block w-full h-[52px] pl-4 pr-12 bg-[#181622]/80 border border-[#2D2A3A] hover:border-[#3D3A4D] rounded-xl text-sm text-white placeholder-slate-500 focus:outline-none focus:border-indigo-500/80 focus:ring-1 focus:ring-indigo-500/30 transition-all"
                />
                <!-- Visibility Toggle Button -->
                <button
                  id="toggleSignupPassword"
                  type="button"
                  class="absolute inset-y-0 right-0 pr-4 flex items-center text-slate-500 hover:text-slate-300 transition-colors"
                >
                  <Eye id="signupEyeIcon" class="w-5 h-5" />
                  <EyeOff id="signupEyeOffIcon" class="w-5 h-5 hidden" />
                </button>
              </div>

              <!-- Terms & Conditions Checkbox -->
              <div class="flex items-center text-xs pt-1">
                <label class="flex items-start cursor-pointer select-none">
                  <input
                    id="signup-terms"
                    name="terms"
                    type="checkbox"
                    required
                    class="sr-only peer"
                  />
                  <div class="w-4 h-4 rounded border border-[#2D2A3A] bg-[#181622] peer-checked:bg-indigo-600 peer-checked:border-indigo-600 flex items-center justify-center transition-all mr-2 mt-0.5 flex-shrink-0">
                    <svg class="w-2.5 h-2.5 text-white opacity-0 peer-checked:opacity-100 transition-opacity" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                    </svg>
                  </div>
                  <span class="text-slate-400 peer-checked:text-slate-300 leading-tight">
                    I agree to the <a href="#" class="text-indigo-400 hover:underline">Terms & Conditions</a>
                  </span>
                </label>
              </div>

              <!-- Submit Button -->
              <button
                type="submit"
                class="w-full h-[50px] rounded-xl bg-[#6C5DD3] hover:bg-[#5C4EB7] text-white font-semibold text-sm transition-all shadow-lg shadow-indigo-500/10 hover:shadow-indigo-500/20 active:scale-[0.99] mt-6 flex items-center justify-center gap-1.5"
              >
                Create account
              </button>
            </form>

            <!-- Divider -->
            <div class="mt-8">
              <div class="relative flex items-center justify-center mb-6">
                <div class="absolute inset-0 flex items-center">
                  <div class="w-full border-t border-[#2D2A3A]"></div>
                </div>
                <span class="relative px-4 bg-[#110F18] text-[11px] text-slate-500 font-semibold tracking-wide uppercase">Or register with</span>
              </div>

              <!-- Social Buttons -->
              <div class="grid grid-cols-2 gap-4">
                <button
                  id="googleSignupBtn"
                  type="button"
                  class="w-full h-[50px] rounded-xl bg-transparent border border-[#2D2A3A] hover:bg-white/5 text-slate-200 hover:text-white font-semibold text-xs flex items-center justify-center gap-2.5 transition-all"
                >
                  <svg class="w-4 h-4" viewBox="0 0 24 24">
                    <path fill="#EA4335" d="M12.24 10.285V14.4h6.887c-.648 2.41-2.519 4.114-5.136 4.114A5.53 5.53 0 0 1 8.4 12.99a5.53 5.53 0 0 1 5.59-5.53c2.44 0 4.135 1.05 4.887 1.77l3.253-3.253C20.177 4.09 17.382 2.76 13.99 2.76A9.23 9.23 0 0 0 4.76 12a9.23 9.23 0 0 0 9.23 9.24c5.38 0 8.97-3.78 8.97-9.12 0-.62-.05-1.22-.17-1.835h-10.55Z"/>
                  </svg>
                  Google
                </button>
                <button
                  id="magicLinkSignupBtn"
                  type="button"
                  class="w-full h-[50px] rounded-xl bg-transparent border border-[#2D2A3A] hover:bg-white/5 text-slate-200 hover:text-white font-semibold text-xs flex items-center justify-center gap-2.5 transition-all"
                >
                  <Mail class="w-4 h-4 text-indigo-400" />
                  Magic Link
                </button>
              </div>
            </div>
          </div>

        </div>

      </div>
    </div>
  </div>

  <script>
    import { createClient } from '@supabase/supabase-js';

    // Retrieve config from DOM
    const configEl = document.getElementById('auth-config');
    const supabaseUrl = configEl?.getAttribute('data-url') || 'https://mock.supabase.co';
    const supabaseAnonKey = configEl?.getAttribute('data-key') || 'mock-key';

    // Initialize Supabase Client
    const supabase = createClient(supabaseUrl, supabaseAnonKey);

    const loginForm = document.getElementById('loginForm') as HTMLFormElement;
    const signupForm = document.getElementById('signupForm') as HTMLFormElement;
    
    // Auth Trigger buttons
    const googleBtn = document.getElementById('googleLoginBtn');
    const googleSignupBtn = document.getElementById('googleSignupBtn');
    const magicLinkBtn = document.getElementById('magicLinkBtn');
    const magicLinkSignupBtn = document.getElementById('magicLinkSignupBtn');

    // Switch buttons
    const switchToSignup = document.getElementById('switch-to-signup');
    const switchToLogin = document.getElementById('switch-to-login');

    const loginFormWrapper = document.getElementById('login-form-wrapper');
    const signupFormWrapper = document.getElementById('signup-form-wrapper');

    const API_URL = import.meta.env.PUBLIC_API_URL || 'http://localhost:3000'; // Target API port

    // Switch between Login and Signup with animation
    function setAuthMode(mode: 'login' | 'signup') {
      if (mode === 'signup') {
        // Prepare login to slide away
        loginFormWrapper?.classList.remove('relative', 'opacity-100', 'translate-x-0', 'pointer-events-auto');
        loginFormWrapper?.classList.add('absolute', 'opacity-0', '-translate-x-12', 'pointer-events-none');
        
        // Prepare signup to slide in
        signupFormWrapper?.classList.remove('absolute', 'opacity-0', 'translate-x-12', 'pointer-events-none');
        signupFormWrapper?.classList.add('relative', 'opacity-100', 'translate-x-0', 'pointer-events-auto');
      } else {
        // Prepare login to slide back in
        loginFormWrapper?.classList.remove('absolute', 'opacity-0', '-translate-x-12', 'pointer-events-none');
        loginFormWrapper?.classList.add('relative', 'opacity-100', 'translate-x-0', 'pointer-events-auto');
        
        // Prepare signup to slide out
        signupFormWrapper?.classList.remove('relative', 'opacity-100', 'translate-x-0', 'pointer-events-auto');
        signupFormWrapper?.classList.add('absolute', 'opacity-0', 'translate-x-12', 'pointer-events-none');
      }
    }

    switchToSignup?.addEventListener('click', (e) => {
      e.preventDefault();
      setAuthMode('signup');
    });

    switchToLogin?.addEventListener('click', (e) => {
      e.preventDefault();
      setAuthMode('login');
    });

    // Submissions
    loginForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const email = (document.getElementById('email') as HTMLInputElement).value;
      const password = (document.getElementById('password') as HTMLInputElement).value;
      const isMockMode = supabaseUrl.includes('mock.supabase.co') || supabaseAnonKey === 'mock-key';

      if (isMockMode) {
        // Fallback for demo/testing mode
        localStorage.setItem('gp_token', 'mock-session-token');
        localStorage.setItem('gp_user', JSON.stringify({ email, role: 'Pro', fullName: email.split('@')[0] }));
        window.location.href = '/dashboard';
        return;
      }

      try {
        const { data, error } = await supabase.auth.signInWithPassword({ email, password });
        if (error) throw error;

        if (data.session) {
          const userMetadata = data.session.user.user_metadata || {};
          const userObj = {
            id: data.session.user.id,
            email: data.session.user.email,
            fullName: userMetadata.full_name || email.split('@')[0],
            role: 'Pro'
          };
          localStorage.setItem('gp_token', data.session.access_token);
          localStorage.setItem('gp_user', JSON.stringify(userObj));

          // Sync user with backend
          try {
            await fetch(`${API_URL}/api/auth/login`, {
              method: 'POST',
              headers: { 
                'Content-Type': 'application/json',
                'Authorization': `Bearer ${data.session.access_token}`
              },
              body: JSON.stringify({ email, fullName: userObj.fullName })
            });
          } catch (syncErr) {
            console.warn('Backend sync failed', syncErr);
          }

          window.location.href = '/dashboard';
        } else {
          alert('Login failed: Session not created');
        }
      } catch (err: any) {
        console.error('Login error', err);
        alert(err.message || 'Authentication failed');
      }
    });

    signupForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const firstName = (document.getElementById('signup-first-name') as HTMLInputElement).value;
      const lastName = (document.getElementById('signup-last-name') as HTMLInputElement).value;
      const email = (document.getElementById('signup-email') as HTMLInputElement).value;
      const password = (document.getElementById('signup-password') as HTMLInputElement).value;
      const termsChecked = (document.getElementById('signup-terms') as HTMLInputElement).checked;

      if (!termsChecked) {
        alert('You must agree to the Terms & Conditions');
        return;
      }

      const fullName = `${firstName} ${lastName}`.trim();
      const isMockMode = supabaseUrl.includes('mock.supabase.co') || supabaseAnonKey === 'mock-key';

      if (isMockMode) {
        // Fallback for demo
        localStorage.setItem('gp_token', 'mock-session-token');
        localStorage.setItem('gp_user', JSON.stringify({ email, fullName, role: 'Pro' }));
        window.location.href = '/dashboard';
        return;
      }

      try {
        const { data, error } = await supabase.auth.signUp({
          email,
          password,
          options: {
            emailRedirectTo: `${window.location.origin}/auth/callback`,
            data: {
              full_name: fullName,
            }
          }
        });

        if (error) throw error;

        if (data.session) {
          const userObj = {
            id: data.session.user.id,
            email: data.session.user.email,
            fullName: fullName,
            role: 'Pro'
          };
          localStorage.setItem('gp_token', data.session.access_token);
          localStorage.setItem('gp_user', JSON.stringify(userObj));

          // Sync with API
          try {
            await fetch(`${API_URL}/api/auth/login`, {
              method: 'POST',
              headers: { 
                'Content-Type': 'application/json',
                'Authorization': `Bearer ${data.session.access_token}`
              },
              body: JSON.stringify({ email, fullName })
            });
          } catch (syncErr) {
            console.warn('Backend sync failed', syncErr);
          }

          window.location.href = '/dashboard';
        } else {
          alert('Sign up successful! Please check your email to confirm your account.');
        }
      } catch (err: any) {
        console.error('Signup error', err);
        alert(err.message || 'Registration failed');
      }
    });

    // Google / Magic Link Integration
    const handleGoogleLogin = async () => {
      const isMockMode = supabaseUrl.includes('mock.supabase.co') || supabaseAnonKey === 'mock-key';
      if (isMockMode) {
        localStorage.setItem('gp_token', 'mock-session-token');
        localStorage.setItem('gp_user', JSON.stringify({ email: 'alex@gigpilot.ai', fullName: 'Alex Rivera', role: 'Pro' }));
        window.location.href = '/dashboard';
        return;
      }

      try {
        const { error } = await supabase.auth.signInWithOAuth({
          provider: 'google',
          options: {
            redirectTo: `${window.location.origin}/auth/callback`,
            queryParams: {
              access_type: 'offline',
              prompt: 'consent',
            }
          }
        });
        if (error) throw error;
      } catch (err: any) {
        console.error('Google OAuth error', err);
        alert(err.message || 'Failed to initialize Google Login');
      }
    };

    googleBtn?.addEventListener('click', handleGoogleLogin);
    googleSignupBtn?.addEventListener('click', handleGoogleLogin);

    const handleMagicLink = async (emailInputId: string) => {
      const email = (document.getElementById(emailInputId) as HTMLInputElement).value;
      if (!email) {
        alert('Please enter an email address first');
        return;
      }
      const isMockMode = supabaseUrl.includes('mock.supabase.co') || supabaseAnonKey === 'mock-key';
      if (isMockMode) {
        alert('Simulating magic link: Check console or click redirect!');
        console.log('Mock Magic Link URL: http://localhost:4321/dashboard');
        localStorage.setItem('gp_token', 'mock-session-token');
        localStorage.setItem('gp_user', JSON.stringify({ email, fullName: email.split('@')[0], role: 'Pro' }));
        window.location.href = '/dashboard';
        return;
      }

      try {
        const { error } = await supabase.auth.signInWithOtp({
          email,
          options: {
            emailRedirectTo: `${window.location.origin}/auth/callback`
          }
        });
        if (error) throw error;
        alert('Magic link sent! Please check your email.');
      } catch (err: any) {
        console.error('Magic link error', err);
        alert(err.message || 'Failed to send magic link');
      }
    };

    magicLinkBtn?.addEventListener('click', () => handleMagicLink('email'));
    magicLinkSignupBtn?.addEventListener('click', () => handleMagicLink('signup-email'));

    // Password visibility toggle (Login)
    const togglePasswordBtn = document.getElementById('togglePassword');
    const passwordInput = document.getElementById('password') as HTMLInputElement;
    const eyeIcon = document.getElementById('eyeIcon');
    const eyeOffIcon = document.getElementById('eyeOffIcon');

    togglePasswordBtn?.addEventListener('click', () => {
      if (passwordInput.type === 'password') {
        passwordInput.type = 'text';
        eyeIcon?.classList.add('hidden');
        eyeOffIcon?.classList.remove('hidden');
      } else {
        passwordInput.type = 'password';
        eyeIcon?.classList.remove('hidden');
        eyeOffIcon?.classList.add('hidden');
      }
    });

    // Password visibility toggle (Signup)
    const toggleSignupPasswordBtn = document.getElementById('toggleSignupPassword');
    const signupPasswordInput = document.getElementById('signup-password') as HTMLInputElement;
    const signupEyeIcon = document.getElementById('signupEyeIcon');
    const signupEyeOffIcon = document.getElementById('signupEyeOffIcon');

    toggleSignupPasswordBtn?.addEventListener('click', () => {
      if (signupPasswordInput.type === 'password') {
        signupPasswordInput.type = 'text';
        signupEyeIcon?.classList.add('hidden');
        signupEyeOffIcon?.classList.remove('hidden');
      } else {
        signupPasswordInput.type = 'password';
        signupEyeIcon?.classList.remove('hidden');
        signupEyeOffIcon?.classList.add('hidden');
      }
    });

    // Left column carousel logic
    const titles = [
      "Scale Your Fiverr Business to Top Rated Seller",
      "Optimize Gig SEO & Find Profitable Keywords",
      "Write Winning Proposals & Structure Pricing"
    ];

    const titleEl = document.getElementById('carousel-title');
    const indicators = document.querySelectorAll('#carousel-indicators span');

    let currentSlide = 0;

    function nextSlide() {
      currentSlide = (currentSlide + 1) % titles.length;
      if (titleEl) {
        titleEl.style.opacity = '0';
        titleEl.style.transform = 'translateY(8px)';
        
        setTimeout(() => {
          titleEl.textContent = titles[currentSlide];
          titleEl.style.opacity = '1';
          titleEl.style.transform = 'translateY(0)';
          
          indicators.forEach((indicator, idx) => {
            if (idx === currentSlide) {
              indicator.className = "w-6 h-1 rounded bg-white transition-all duration-300";
            } else {
              indicator.className = "w-4 h-1 rounded bg-white/30 transition-all duration-300";
            }
          });
        }, 300);
      }
    }

    if (titleEl) {
      titleEl.style.transition = 'all 0.3s ease';
    }

    setInterval(nextSlide, 4000);
  </script>
</Layout>
