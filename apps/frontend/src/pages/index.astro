---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import { Bot, Zap, ArrowRight, Shield, CheckCircle, Sparkles, MessageSquare, Play, HelpCircle, Search } from 'lucide-react';
import logoBlack from '../assets/logoblack.png';
import { FadeIn, SlideUp, Stagger, StaggerItem, HoverCard, GlowButton, FloatingElement, ScrollReveal, FaqAccordion, TestimonialCarousel } from '../components/animations';

const faqItems = [
  {
    question: "Does GigPilot AI automatically publish Gigs on my Fiverr profile?",
    answer: "No. GigPilot AI is built to keep you fully compliant with Fiverr's Terms of Service. It operates as a content generator and review assistant. You copy the content and paste it manually into the Fiverr forms."
  },
  {
    question: "What AI models are supported?",
    answer: "We feature a multi-LLM abstraction layers that supports OpenAI (GPT-4o), Google Gemini, Anthropic Claude, Groq (for blazing fast iterations), and OpenRouter models. You can select your provider inside the workspace."
  },
  {
    question: "How do credits work?",
    answer: "Each generation (e.g., generating a Gig description, a proposal script, or running a keyword difficulty check) consumes 1 credit. The Free tier includes 50 credits/mo, while the Pro tier refreshes to 500 credits/mo."
  },
  {
    question: "Can I manage multiple profiles?",
    answer: "Yes, our Agency plan allows you to link multiple sub-accounts, manage templates centrally, and divide credits among your team members."
  }
];
---

<Layout title="GigPilot AI - The AI Operating System for Fiverr Freelancers">
  <!-- Global overrides for light theme landing page -->
  <style is:global>
    html, body {
      background-color: #FAF9F6 !important;
      color: #0f172a !important;
      scroll-behavior: smooth;
    }

    @keyframes float {
      0%, 100% { transform: translateY(0); }
      50% { transform: translateY(-8px); }
    }

    .animate-float {
      animation: float 6s ease-in-out infinite;
    }
  </style>

  <!-- Top Navbar -->
  <header class="sticky top-0 z-50 w-full bg-transparent border-b border-transparent transition-all duration-300" id="main-header">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-5 flex items-center justify-between transition-all duration-300" id="header-inner">
      <a href="/" class="flex items-center gap-2.5 group">
        <div class="w-9 h-9 flex items-center justify-center group-hover:scale-110 transition-transform duration-300">
          <Image src={logoBlack} alt="GigPilot Logo" width={36} height={36} class="w-9 h-9 object-contain" />
        </div>
        <div>
          <span class="font-extrabold text-base tracking-tight text-slate-900 flex items-center gap-1.5">
            GigPilot <span class="text-[10px] px-1.5 py-0.5 rounded bg-green-500/10 text-slate-900 font-semibold border border-green-500/20">AI</span>
          </span>
        </div>
      </a>

      <nav class="hidden md:flex items-center gap-8">
        <a href="#features" class="text-sm font-bold text-slate-700 hover:text-slate-950 transition-colors relative py-1 group">
          Features
          <span class="absolute bottom-0 left-0 w-0 h-0.5 bg-green-600 transition-all duration-300 group-hover:w-full"></span>
        </a>
        <a href="#demo" class="text-sm font-bold text-slate-700 hover:text-slate-950 transition-colors relative py-1 group">
          AI Demo
          <span class="absolute bottom-0 left-0 w-0 h-0.5 bg-green-600 transition-all duration-300 group-hover:w-full"></span>
        </a>
        <a href="#pricing" class="text-sm font-bold text-slate-700 hover:text-slate-950 transition-colors relative py-1 group">
          Pricing
          <span class="absolute bottom-0 left-0 w-0 h-0.5 bg-green-600 transition-all duration-300 group-hover:w-full"></span>
        </a>
        <a href="#faq" class="text-sm font-bold text-slate-700 hover:text-slate-950 transition-colors relative py-1 group">
          FAQ
          <span class="absolute bottom-0 left-0 w-0 h-0.5 bg-green-600 transition-all duration-300 group-hover:w-full"></span>
        </a>
      </nav>

      <div class="flex items-center gap-3">
        <GlowButton client:load variant="outline" href="/login" className="px-5 py-2.5 text-sm h-10">
          Log In
        </GlowButton>
        <GlowButton client:load variant="primary" href="/tools/gig-generator" className="px-5 py-2.5 text-sm h-10 bg-[#8DE55A] hover:bg-[#7ad34a]">
          Sign Up
        </GlowButton>
      </div>
    </div>
  </header>

  <!-- Hero Section -->
  <section class="-mt-20 relative min-h-[92dvh] pt-40 pb-28 flex flex-col justify-between overflow-hidden bg-[url('/green_hills_bg.jpg')] bg-cover bg-bottom bg-no-repeat">
    <!-- Aurora background elements -->
    <div class="aurora-container">
      <div class="aurora-glow-1"></div>
      <div class="aurora-glow-2"></div>
    </div>

    <!-- Overlay to ensure text readability -->
    <div class="absolute inset-0 bg-gradient-to-b from-white/40 via-white/15 to-transparent pointer-events-none"></div>

    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10 my-auto">
      <!-- Tagline Pill -->
      <FadeIn client:load direction="down" delay={0.1}>
        <div class="inline-flex items-center px-4 py-1.5 rounded-full bg-green-50/90 border border-green-200/80 text-green-800 text-[10px] font-bold tracking-wider uppercase mb-6 shadow-sm">
          The AI Operating System for Fiverr Freelancers
        </div>
      </FadeIn>

      <!-- Main Headline -->
      <SlideUp client:load delay={0.2} offset={30}>
        <h1 class="text-4xl sm:text-6xl font-extrabold tracking-tight text-slate-900 mb-6 leading-[1.1] max-w-4xl mx-auto">
          Scale Your Fiverr Business to <span class="bg-gradient-to-r from-green-700 via-green-600 to-teal-700 bg-clip-text text-transparent">Top Rated Seller</span> with AI.
        </h1>
      </SlideUp>

      <!-- Subtitle -->
      <FadeIn client:load delay={0.35} duration={0.6}>
        <p class="text-base sm:text-lg text-slate-700 max-w-2xl mx-auto mb-10 leading-relaxed font-medium">
          Optimize your gig SEO, write winning proposals, find profitable keywords, audit your health, and structure your pricing. Build your freelancing empire safely.
        </p>
      </FadeIn>

      <!-- CTA Buttons -->
      <FadeIn client:load delay={0.5}>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-16">
          <GlowButton client:load variant="primary" href="/tools/gig-generator" className="w-full sm:w-auto px-7 py-4">
            Generate Your First Fiverr Gig <ArrowRight class="w-4 h-4 text-slate-950" />
          </GlowButton>
          <GlowButton client:load variant="outline" href="#demo" className="w-full sm:w-auto px-7 py-4 bg-white/80 hover:bg-white text-slate-800 border border-slate-200/80">
            <Play class="w-4 h-4 text-green-600 fill-green-600/20" /> Watch Demo
          </GlowButton>
        </div>
      </FadeIn>

      <!-- Hero Mockup Frame -->
      <FadeIn client:load delay={0.6} direction="up" className="max-w-4xl mx-auto mb-12">
        <FloatingElement client:load duration={6} yOffset={8} className="relative w-full rounded-2xl border border-slate-200/60 bg-white/70 p-1.5 shadow-2xl backdrop-blur-xl">
          <div class="absolute -top-4 -left-4 w-40 h-40 bg-green-500/10 blur-3xl pointer-events-none rounded-full"></div>
          <div class="absolute -bottom-4 -right-4 w-40 h-40 bg-teal-500/10 blur-3xl pointer-events-none rounded-full"></div>

          <div class="bg-slate-50 border border-slate-200/80 rounded-xl overflow-hidden shadow-inner">
            <!-- Window Header -->
            <div id="demo" class="bg-slate-100/90 px-4 py-3 flex items-center justify-between border-b border-slate-200/60">
              <div class="flex items-center gap-2">
                <span class="w-2.5 h-2.5 rounded-full bg-red-400"></span>
                <span class="w-2.5 h-2.5 rounded-full bg-yellow-400"></span>
                <span class="w-2.5 h-2.5 rounded-full bg-green-400"></span>
                <span class="text-[10px] text-slate-500 font-mono ml-2">workspace://gigpilot-workspace</span>
              </div>
              <div class="text-[10px] px-2 py-0.5 rounded bg-green-500/10 text-green-700 font-semibold border border-green-500/20 flex items-center gap-1">
                <Zap class="w-3 h-3 text-green-600" /> Live Sandbox
              </div>
            </div>

            <!-- Mockup Content (AI Gig Generator Demo) -->
            <div class="p-6 text-left grid grid-cols-1 md:grid-cols-5 gap-6">
              <!-- Form Input Side -->
              <div class="md:col-span-2 space-y-4 border-r border-slate-200/85 pr-0 md:pr-6">
                <div class="text-xs font-bold text-slate-500 uppercase tracking-wider">Gig Parameters</div>

                <div>
                  <label class="block text-[11px] font-bold text-slate-500 mb-1.5">Service/Niche</label>
                  <div class="w-full bg-white border border-slate-200 rounded-lg px-3 py-2 text-xs text-slate-800 font-medium">
                    Next.js Developer & API Integration
                  </div>
                </div>

                <div class="grid grid-cols-2 gap-3">
                  <div>
                    <label class="block text-[11px] font-bold text-slate-500 mb-1.5">Experience</label>
                    <div class="w-full bg-white border border-slate-200 rounded-lg px-3 py-2 text-xs text-slate-800 font-medium">
                      Expert
                    </div>
                  </div>
                  <div>
                    <label class="block text-[11px] font-bold text-slate-500 mb-1.5">Tone</label>
                    <div class="w-full bg-white border border-slate-200 rounded-lg px-3 py-2 text-xs text-slate-800 font-medium">
                      Persuasive
                    </div>
                  </div>
                </div>

                <div>
                  <label class="block text-[11px] font-bold text-slate-500 mb-1.5">Target Keywords</label>
                  <div class="w-full bg-white border border-slate-200 rounded-lg px-3 py-2 text-xs text-slate-800 font-medium">
                    Next.js, Tailwind CSS, API integration
                  </div>
                </div>

                <button class="w-full py-2.5 rounded-lg bg-green-600 text-white font-bold text-xs flex items-center justify-center gap-1.5 hover:bg-green-500 shadow-md shadow-green-500/10 transition-all cursor-not-allowed" disabled>
                  <Sparkles class="w-3.5 h-3.5" /> Generate Fiverr Gig
                </button>
              </div>

              <!-- Output Preview Side -->
              <div class="md:col-span-3 space-y-4 flex flex-col justify-between">
                <div class="flex items-center justify-between">
                  <span class="text-xs font-bold text-slate-500 uppercase tracking-wider">AI Generated Content</span>
                  <span class="text-[10px] px-1.5 py-0.5 rounded bg-green-500/10 text-green-700 border border-green-500/20 font-semibold">98% SEO Score</span>
                </div>

                <div class="bg-slate-900 p-4 rounded-xl border border-slate-800 space-y-3 font-mono text-[11px] text-slate-300 flex-1 overflow-y-auto max-h-[220px] shadow-inner">
                  <div class="text-green-400 font-semibold mb-1">// SEO-Optimized Title</div>
                  <div class="text-white border-l-2 border-green-500 pl-2 py-0.5 mb-3 font-sans">
                    "I will build Next.js websites, Tailwind CSS landing pages, and API integrations"
                  </div>

                  <div class="text-green-400 font-semibold mb-1">// SEO Search Tags</div>
                  <div class="flex flex-wrap gap-1.5 mb-3">
                    <span class="bg-slate-800 text-[10px] text-slate-400 px-2 py-0.5 rounded border border-slate-700 hover:border-green-500/40 hover:text-white transition-colors cursor-pointer">nextjs</span>
                    <span class="bg-slate-800 text-[10px] text-slate-400 px-2 py-0.5 rounded border border-slate-700 hover:border-green-500/40 hover:text-white transition-colors cursor-pointer">tailwindcss</span>
                    <span class="bg-slate-800 text-[10px] text-slate-400 px-2 py-0.5 rounded border border-slate-700 hover:border-green-500/40 hover:text-white transition-colors cursor-pointer">api-integration</span>
                    <span class="bg-slate-800 text-[10px] text-slate-400 px-2 py-0.5 rounded border border-slate-700 hover:border-green-500/40 hover:text-white transition-colors cursor-pointer">react</span>
                    <span class="bg-slate-800 text-[10px] text-slate-400 px-2 py-0.5 rounded border border-slate-700 hover:border-green-500/40 hover:text-white transition-colors cursor-pointer">website-development</span>
                  </div>

                  <div class="text-green-400 font-semibold mb-1">// Description Preview</div>
                  <p class="text-slate-400 font-sans leading-relaxed">
                    Are you looking for a fully optimized, responsive, and blazing-fast Next.js website? I will develop a high-converting, clean site using Next.js and Tailwind CSS...
                  </p>
                </div>

                <div class="flex items-center justify-between text-xs text-slate-500 border-t border-slate-200/80 pt-3">
                  <span class="flex items-center gap-1.5 font-medium"><Shield class="w-3.5 h-3.5 text-green-600" /> Fiverr Compliant</span>
                  <a href="/tools/gig-generator" class="text-green-700 hover:text-green-600 font-bold flex items-center gap-1 transition-all hover:translate-x-1">Try Generator <ArrowRight class="w-3.5 h-3.5" /></a>
                </div>
              </div>
            </div>
          </div>
        </FloatingElement>
      </FadeIn>

      <!-- Social Proof / Logo Wall -->
      <FadeIn client:load delay={0.75} direction="up">
        <div class="mt-8 text-center">
          <div class="text-xs font-bold uppercase tracking-widest text-white/75 mb-5">Used by managers from</div>
          <div class="flex flex-wrap items-center justify-center gap-x-12 gap-y-6">
            <img src="https://cdn.simpleicons.org/vimeo/ffffff" alt="Vimeo" class="h-6 w-auto opacity-75 hover:opacity-100 hover:scale-105 transition-all" />
            <img src="https://cdn.simpleicons.org/uber/ffffff" alt="Uber" class="h-6 w-auto opacity-75 hover:opacity-100 hover:scale-105 transition-all" />
            <img src="https://cdn.simpleicons.org/stripe/ffffff" alt="Stripe" class="h-6 w-auto opacity-75 hover:opacity-100 hover:scale-105 transition-all" />
            <img src="https://cdn.simpleicons.org/google/ffffff" alt="Google" class="h-6 w-auto opacity-75 hover:opacity-100 hover:scale-105 transition-all" />
            <img src="https://cdn.simpleicons.org/revolut/ffffff" alt="Revolut" class="h-6 w-auto opacity-75 hover:opacity-100 hover:scale-105 transition-all" />
          </div>
        </div>
      </FadeIn>
    </div>
  </section>

  <!-- Scroll Listener: shrink navbar on scroll -->
  <script>
    const header = document.getElementById('main-header');
    const headerInner = document.getElementById('header-inner');

    function updateNav() {
      if (window.scrollY > 10) {
        header.classList.remove('bg-transparent', 'border-transparent');
        header.classList.add('bg-white', 'border-slate-200/60', 'shadow-md', 'shadow-slate-100/80');
        headerInner.classList.remove('py-5');
        headerInner.classList.add('py-3');
      } else {
        header.classList.add('bg-transparent', 'border-transparent');
        header.classList.remove('bg-white', 'border-slate-200/60', 'shadow-md', 'shadow-slate-100/80');
        headerInner.classList.add('py-5');
        headerInner.classList.remove('py-3');
      }
    }

    if (header && headerInner) {
      window.addEventListener('scroll', updateNav, { passive: true });
      updateNav();
    }
  </script>

  <!-- Features Section -->
  <section id="features" class="py-24 bg-[#F3F5F2] border-t border-slate-200/50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <ScrollReveal client:visible animation="slide-up" duration={0.8} threshold={0.15}>
        <div class="text-center max-w-2xl mx-auto mb-16">
          <h2 class="text-3xl font-extrabold text-slate-900 mb-4 tracking-tight">Complete Suite for Fiverr Sellers</h2>
          <p class="text-slate-600 text-sm font-medium">Everything you need to automate your workspace, get more impressions, write stellar proposals, and close clients with zero manual stress.</p>
        </div>
      </ScrollReveal>

      <Stagger client:visible className="grid grid-cols-1 md:grid-cols-3 gap-8">
        <!-- Feature 1 -->
        <StaggerItem client:load className="h-full">
          <HoverCard client:visible glowColor="rgba(141, 229, 90, 0.15)" className="bg-white border-slate-200/80 p-7 group h-full">
            <div class="w-11 h-11 rounded-xl bg-green-50 text-green-600 flex items-center justify-center mb-5 group-hover:bg-green-600 group-hover:text-white transition-all duration-300 shadow-sm">
              <Zap class="w-5.5 h-5.5 animate-pulse" />
            </div>
            <h3 class="text-base font-extrabold text-slate-900 mb-2.5">AI Gig Generator</h3>
            <p class="text-slate-600 text-xs leading-relaxed font-medium">Generate titles, search tags, 3-tier pricing descriptions, custom FAQs, image prompts, and video scripts matching high-CTR templates.</p>
          </HoverCard>
        </StaggerItem>

        <!-- Feature 2 -->
        <StaggerItem client:load className="h-full">
          <HoverCard client:visible glowColor="rgba(141, 229, 90, 0.15)" className="bg-white border-slate-200/80 p-7 group h-full">
            <div class="w-11 h-11 rounded-xl bg-green-50 text-green-600 flex items-center justify-center mb-5 group-hover:bg-green-600 group-hover:text-white transition-all duration-300 shadow-sm">
              <MessageSquare class="w-5.5 h-5.5" />
            </div>
            <h3 class="text-base font-extrabold text-slate-900 mb-2.5">Proposal Writer</h3>
            <p class="text-slate-600 text-xs leading-relaxed font-medium">Draft highly conversion-focused proposals for buyer requests, customize messages, follow up, and handle inbox replies in seconds.</p>
          </HoverCard>
        </StaggerItem>

        <!-- Feature 3 -->
        <StaggerItem client:load className="h-full">
          <HoverCard client:visible glowColor="rgba(141, 229, 90, 0.15)" className="bg-white border-slate-200/80 p-7 group h-full">
            <div class="w-11 h-11 rounded-xl bg-green-50 text-green-600 flex items-center justify-center mb-5 group-hover:bg-green-600 group-hover:text-white transition-all duration-300 shadow-sm">
              <Search class="w-5.5 h-5.5" />
            </div>
            <h3 class="text-base font-extrabold text-slate-900 mb-2.5">Keyword & Tag Finder</h3>
            <p class="text-slate-600 text-xs leading-relaxed font-medium">Extract primary and long-tail Fiverr tags. Understand search volume tiers, competitor tags, and overall keyword difficulty ratings.</p>
          </HoverCard>
        </StaggerItem>

        <!-- Feature 4 -->
        <StaggerItem client:load className="h-full">
          <HoverCard client:visible glowColor="rgba(141, 229, 90, 0.15)" className="bg-white border-slate-200/80 p-7 group h-full">
            <div class="w-11 h-11 rounded-xl bg-green-50 text-green-600 flex items-center justify-center mb-5 group-hover:bg-green-600 group-hover:text-white transition-all duration-300 shadow-sm">
              <CheckCircle class="w-5.5 h-5.5" />
            </div>
            <h3 class="text-base font-extrabold text-slate-900 mb-2.5">Pricing & Extras Optimizer</h3>
            <p class="text-slate-600 text-xs leading-relaxed font-medium">Compare pricing tiers for your service category and experience. Find optimal upsells and extras to boost average order value.</p>
          </HoverCard>
        </StaggerItem>

        <!-- Feature 5 -->
        <StaggerItem client:load className="h-full">
          <HoverCard client:visible glowColor="rgba(141, 229, 90, 0.15)" className="bg-white border-slate-200/80 p-7 group h-full">
            <div class="w-11 h-11 rounded-xl bg-green-50 text-green-600 flex items-center justify-center mb-5 group-hover:bg-green-600 group-hover:text-white transition-all duration-300 shadow-sm">
              <Bot class="w-5.5 h-5.5" />
            </div>
            <h3 class="text-base font-extrabold text-slate-900 mb-2.5">SEO Audit & Health Score</h3>
            <p class="text-slate-600 text-xs leading-relaxed font-medium">Paste your current title, tags, and descriptions to retrieve immediate, actionable conversion checklist scores and fixes.</p>
          </HoverCard>
        </StaggerItem>

        <!-- Feature 6 -->
        <StaggerItem client:load className="h-full">
          <HoverCard client:visible glowColor="rgba(141, 229, 90, 0.15)" className="bg-white border-slate-200/80 p-7 group h-full">
            <div class="w-11 h-11 rounded-xl bg-green-50 text-green-600 flex items-center justify-center mb-5 group-hover:bg-green-600 group-hover:text-white transition-all duration-300 shadow-sm">
              <Shield class="w-5.5 h-5.5" />
            </div>
            <h3 class="text-base font-extrabold text-slate-900 mb-2.5">Safe Publish Flow</h3>
            <p class="text-slate-600 text-xs leading-relaxed font-medium">A clean UI that aids content generation and allows manual copying. Does not violate Fiverr terms of service by auto-publishing.</p>
          </HoverCard>
        </StaggerItem>
      </Stagger>
    </div>
  </section>

  <!-- Testimonials Section -->
  <section class="py-24 bg-[#EAECE9] border-t border-slate-200/50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <ScrollReveal client:visible animation="slide-up" duration={0.8} threshold={0.15}>
        <div class="text-center max-w-2xl mx-auto mb-8">
          <h2 class="text-3xl font-extrabold text-slate-900 mb-4 tracking-tight">Approved by Fiverr Elites</h2>
          <p class="text-slate-600 text-sm font-medium">Read how top freelancers use GigPilot AI to boost conversion rates and increase order values.</p>
        </div>
      </ScrollReveal>
      <ScrollReveal client:visible animation="slide-up" duration={0.8} threshold={0.1} delay={0.15}>
        <TestimonialCarousel client:visible />
      </ScrollReveal>
    </div>
  </section>

  <!-- Pricing Section -->
  <section id="pricing" class="py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <ScrollReveal client:visible animation="slide-up" duration={0.8} threshold={0.15}>
        <div class="text-center max-w-2xl mx-auto mb-16">
          <h2 class="text-3xl font-extrabold text-slate-900 mb-4 tracking-tight">Pricing Built for Your Budget</h2>
          <p class="text-slate-600 text-sm font-medium">Start optimization for free and upgrade as your freelance business starts scaling up.</p>
        </div>
      </ScrollReveal>

      <Stagger client:visible className="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-5xl mx-auto">
        <!-- Tier 1 -->
        <StaggerItem client:load className="h-full">
          <HoverCard client:visible glowColor="rgba(141, 229, 90, 0.12)" className="bg-[#F8F9FA] border-slate-200 p-8 flex flex-col justify-between group h-full">
            <div>
              <h3 class="text-lg font-bold text-slate-900 mb-2">Free Starter</h3>
              <p class="text-slate-500 text-xs mb-6 font-medium">Explore tools and validate your initial Fiverr gig ideas.</p>
              <div class="text-3xl font-extrabold text-slate-900 mb-6">$0 <span class="text-xs text-slate-400 font-normal">/ forever</span></div>
              <ul class="space-y-3.5 mb-8 text-xs text-slate-700 font-medium">
                <li class="flex items-center gap-2.5"><CheckCircle class="w-4 h-4 text-green-600" /> 50 Generation Credits/mo</li>
                <li class="flex items-center gap-2.5"><CheckCircle class="w-4 h-4 text-green-600" /> AI Gig Generator MVP</li>
                <li class="flex items-center gap-2.5"><CheckCircle class="w-4 h-4 text-green-600" /> 2 Saved Drafts</li>
                <li class="flex items-center gap-2.5"><CheckCircle class="w-4 h-4 text-green-600" /> Base OpenAI Model</li>
              </ul>
            </div>
            <GlowButton client:load variant="outline" href="/tools/gig-generator" className="w-full py-2.5 text-xs">
              Get Started Free
            </GlowButton>
          </HoverCard>
        </StaggerItem>

        <!-- Tier 2 (Featured Pro) -->
        <StaggerItem client:load className="h-full">
