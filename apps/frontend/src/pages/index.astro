---
import Layout from '../layouts/Layout.astro';
import { Bot, Zap, ArrowRight, Shield, CheckCircle, Sparkles, MessageSquare, Play, HelpCircle, Search } from 'lucide-react';
---

<Layout title="GigPilot AI - The AI Operating System for Fiverr Freelancers">
  <!-- Top Navbar -->
  <header class="sticky top-0 z-50 w-full bg-[#0B0F17]/85 backdrop-blur-md border-b border-slate-800/80">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
      <div class="flex items-center gap-2.5">
        <div class="w-9 h-9 rounded-xl bg-gradient-to-tr from-emerald-600 to-teal-600 flex items-center justify-center shadow-lg shadow-emerald-500/25">
          <Bot class="w-5 h-5 text-white" />
        </div>
        <div>
          <span class="font-extrabold text-base tracking-tight text-white flex items-center gap-1">
            GigPilot <span class="text-[10px] px-1.5 py-0.5 rounded bg-emerald-500/20 text-emerald-400 font-semibold border border-emerald-500/30">AI</span>
          </span>
        </div>
      </div>
      
      <nav class="hidden md:flex items-center gap-6">
        <a href="#features" class="text-xs font-medium text-slate-400 hover:text-white transition-colors">Features</a>
        <a href="#demo" class="text-xs font-medium text-slate-400 hover:text-white transition-colors">AI Demo</a>
        <a href="#pricing" class="text-xs font-medium text-slate-400 hover:text-white transition-colors">Pricing</a>
        <a href="#faq" class="text-xs font-medium text-slate-400 hover:text-white transition-colors">FAQ</a>
      </nav>

      <div class="flex items-center gap-3">
        <a href="/login" class="px-3.5 py-1.5 rounded-lg border border-slate-700/80 hover:bg-slate-800/50 text-slate-300 hover:text-white font-medium text-xs transition-all">
          Log In
        </a>
        <a href="/tools/gig-generator" class="px-3.5 py-1.5 rounded-lg bg-gradient-to-r from-emerald-600 to-teal-600 hover:from-emerald-500 hover:to-teal-500 text-white font-medium text-xs shadow-md shadow-emerald-500/15 hover:shadow-emerald-500/25 transition-all">
          Sign Up
        </a>
      </div>
    </div>
  </header>

  <!-- Hero Section -->
  <section class="relative pt-24 pb-20 overflow-hidden bg-radial-gradient">
    <!-- Background Ambient Glow -->
    <div class="absolute top-[-10%] left-[50%] -translate-x-[50%] w-[800px] h-[400px] rounded-full bg-gradient-to-r from-emerald-600/10 via-emerald-600/15 to-teal-600/10 blur-[120px] pointer-events-none" />
    
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10">
      <!-- Tagline Pill -->
      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-300 text-[10px] font-semibold tracking-wider uppercase mb-6 animate-fade-in">
        <Sparkles class="w-3.5 h-3.5 text-emerald-400" /> The AI Operating System for Fiverr Freelancers
      </div>

      <!-- Main Headline -->
      <h1 class="text-4xl sm:text-6xl font-extrabold tracking-tight text-white mb-6 leading-[1.1] max-w-4xl mx-auto">
        Scale Your Fiverr Business to <span class="bg-gradient-to-r from-emerald-400 via-emerald-300 to-teal-400 bg-clip-text text-transparent">Top Rated Seller</span> with AI.
      </h1>

      <!-- Subtitle -->
      <p class="text-base sm:text-lg text-slate-400 max-w-2xl mx-auto mb-10 leading-relaxed">
        Optimize your gig SEO, write winning proposals, find profitable keywords, audit your health, and structure your pricing. Build your freelancing empire safely.
      </p>

      <!-- CTA Buttons -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-16">
        <a href="/tools/gig-generator" class="w-full sm:w-auto px-6 py-3.5 rounded-xl bg-gradient-to-r from-emerald-600 via-emerald-600 to-teal-600 hover:from-emerald-500 hover:to-teal-500 text-white font-semibold text-sm shadow-xl shadow-emerald-500/25 flex items-center justify-center gap-2 hover:-translate-y-0.5 transition-all">
          Generate Your First Fiverr Gig <ArrowRight class="w-4 h-4" />
        </a>
        <a href="#demo" class="w-full sm:w-auto px-6 py-3.5 rounded-xl bg-slate-900/60 border border-slate-800 hover:bg-slate-800/60 text-slate-200 hover:text-white font-semibold text-sm flex items-center justify-center gap-2 transition-all">
          <Play class="w-4 h-4 text-emerald-400 fill-emerald-400/20" /> Watch Demo
        </a>
      </div>

      <!-- Hero Mockup Frame -->
      <div id="demo" class="relative max-w-4xl mx-auto rounded-2xl border border-slate-800/80 bg-slate-900/40 p-1.5 shadow-2xl backdrop-blur-xl">
        <div class="absolute -top-4 -left-4 w-40 h-40 bg-emerald-500/10 blur-3xl pointer-events-none rounded-full" />
        <div class="absolute -bottom-4 -right-4 w-40 h-40 bg-teal-500/10 blur-3xl pointer-events-none rounded-full" />
        
        <div class="bg-[#0f172a]/80 border border-slate-800/60 rounded-xl overflow-hidden shadow-inner">
          <!-- Window Header -->
          <div class="bg-slate-950/80 px-4 py-3 flex items-center justify-between border-b border-slate-800/60">
            <div class="flex items-center gap-2">
              <span class="w-2.5 h-2.5 rounded-full bg-red-500/80"></span>
              <span class="w-2.5 h-2.5 rounded-full bg-yellow-500/80"></span>
              <span class="w-2.5 h-2.5 rounded-full bg-green-500/80"></span>
              <span class="text-[10px] text-slate-500 font-mono ml-2">workspace://gigpilot-workspace</span>
            </div>
            <div class="text-[10px] px-2 py-0.5 rounded bg-emerald-500/10 text-emerald-300 font-semibold border border-emerald-500/20 flex items-center gap-1">
              <Zap class="w-3 h-3" /> Live Sandbox
            </div>
          </div>
          
          <!-- Mockup Content (AI Gig Generator Demo) -->
          <div class="p-6 text-left grid grid-cols-1 md:grid-cols-5 gap-6">
            <!-- Form Input Side -->
            <div class="md:col-span-2 space-y-4 border-r border-slate-800/65 pr-0 md:pr-6">
              <div class="text-xs font-bold text-slate-400 uppercase tracking-wider">Gig Parameters</div>
              
              <div>
                <label class="block text-[11px] font-semibold text-slate-400 mb-1.5">Service/Niche</label>
                <div class="w-full bg-slate-900 border border-slate-800 rounded-lg px-3 py-2 text-xs text-white">
                  Next.js Developer & API Integration
                </div>
              </div>
              
              <div class="grid grid-cols-2 gap-3">
                <div>
                  <label class="block text-[11px] font-semibold text-slate-400 mb-1.5">Experience</label>
                  <div class="w-full bg-slate-900 border border-slate-800 rounded-lg px-3 py-2 text-xs text-white">
                    Expert
                  </div>
                </div>
                <div>
                  <label class="block text-[11px] font-semibold text-slate-400 mb-1.5">Tone</label>
                  <div class="w-full bg-slate-900 border border-slate-800 rounded-lg px-3 py-2 text-xs text-white">
                    Persuasive
                  </div>
                </div>
              </div>

              <div>
                <label class="block text-[11px] font-semibold text-slate-400 mb-1.5">Target Keywords (optional)</label>
                <div class="w-full bg-slate-900 border border-slate-800 rounded-lg px-3 py-2 text-xs text-white">
                  Next.js, Tailwind CSS, API integration
                </div>
              </div>

              <button class="w-full py-2.5 rounded-lg bg-emerald-600 text-white font-bold text-xs flex items-center justify-center gap-1.5 hover:bg-emerald-500 shadow-md shadow-emerald-500/20 transition-all cursor-not-allowed" disabled>
                <Sparkles class="w-3.5 h-3.5" /> Generate Fiverr Gig
              </button>
            </div>
            
            <!-- Output Preview Side -->
            <div class="md:col-span-3 space-y-4 flex flex-col justify-between">
              <div class="flex items-center justify-between">
                <span class="text-xs font-bold text-slate-400 uppercase tracking-wider">AI Generated Content</span>
                <span class="text-[10px] px-1.5 py-0.5 rounded bg-green-500/10 text-green-400 border border-green-500/20 font-medium">98% SEO Score</span>
              </div>
              
              <div class="bg-slate-950/80 p-4 rounded-xl border border-slate-800/80 space-y-3 font-mono text-[11px] text-slate-300 flex-1 overflow-y-auto max-h-[220px]">
                <div class="text-emerald-400 font-semibold mb-1">// SEO-Optimized Title</div>
                <div class="text-white border-l-2 border-emerald-500 pl-2 py-0.5 mb-3 font-sans">
                  "I will build Next.js websites, Tailwind CSS landing pages, and API integrations"
                </div>
                
                <div class="text-emerald-400 font-semibold mb-1">// SEO Search Tags</div>
                <div class="flex flex-wrap gap-1.5 mb-3">
                  <span class="bg-slate-900 text-[10px] text-slate-400 px-2 py-0.5 rounded border border-slate-800">nextjs</span>
                  <span class="bg-slate-900 text-[10px] text-slate-400 px-2 py-0.5 rounded border border-slate-800">tailwindcss</span>
                  <span class="bg-slate-900 text-[10px] text-slate-400 px-2 py-0.5 rounded border border-slate-800">api-integration</span>
                  <span class="bg-slate-900 text-[10px] text-slate-400 px-2 py-0.5 rounded border border-slate-800">react</span>
                  <span class="bg-slate-900 text-[10px] text-slate-400 px-2 py-0.5 rounded border border-slate-800">website-development</span>
                </div>

                <div class="text-emerald-400 font-semibold mb-1">// Description Preview</div>
                <p class="text-slate-400 font-sans leading-relaxed">
                  Are you looking for a fully optimized, responsive, and blazing-fast Next.js website? I will develop a high-converting, clean site using Next.js and Tailwind CSS...
                </p>
              </div>

              <div class="flex items-center justify-between text-xs text-slate-400 border-t border-slate-800/60 pt-3">
                <span class="flex items-center gap-1.5"><Shield class="w-3.5 h-3.5 text-teal-400" /> Fiverr Compliant</span>
                <a href="/tools/gig-generator" class="text-emerald-400 hover:text-emerald-300 font-semibold flex items-center gap-1">Try Generator <ArrowRight class="w-3.5 h-3.5" /></a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Features Section -->
  <section id="features" class="py-20 border-t border-slate-900 bg-[#0c121e]/50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-16">
        <h2 class="text-3xl font-extrabold text-white mb-4">Complete Suite for Fiverr Sellers</h2>
        <p class="text-slate-400 text-sm">Everything you need to automate your workspace, get more impressions, write stellar proposals, and close clients with zero manual stress.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- Feature 1 -->
        <div class="bg-slate-900/40 border border-slate-800/80 rounded-2xl p-6 hover:border-emerald-500/30 transition-all group">
          <div class="w-10 h-10 rounded-xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 flex items-center justify-center mb-4 group-hover:bg-emerald-500 group-hover:text-white transition-all">
            <Zap class="w-5 h-5" />
          </div>
          <h3 class="text-base font-bold text-white mb-2">AI Gig Generator</h3>
          <p class="text-slate-400 text-xs leading-relaxed">Generate titles, search tags, 3-tier pricing descriptions, custom FAQs, image prompts, and video scripts matching high-CTR templates.</p>
        </div>

        <!-- Feature 2 -->
        <div class="bg-slate-900/40 border border-slate-800/80 rounded-2xl p-6 hover:border-teal-500/30 transition-all group">
          <div class="w-10 h-10 rounded-xl bg-teal-500/10 border border-teal-500/20 text-teal-400 flex items-center justify-center mb-4 group-hover:bg-teal-500 group-hover:text-white transition-all">
            <MessageSquare class="w-5 h-5" />
          </div>
          <h3 class="text-base font-bold text-white mb-2">Proposal Writer</h3>
          <p class="text-slate-400 text-xs leading-relaxed">Draft highly conversion-focused proposals for buyer requests, customize messages, follow up, and handle inbox replies in seconds.</p>
        </div>

        <!-- Feature 3 -->
        <div class="bg-slate-900/40 border border-slate-800/80 rounded-2xl p-6 hover:border-emerald-500/30 transition-all group">
          <div class="w-10 h-10 rounded-xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 flex items-center justify-center mb-4 group-hover:bg-emerald-500 group-hover:text-white transition-all">
            <Search class="w-5 h-5" />
          </div>
          <h3 class="text-base font-bold text-white mb-2">Keyword & Tag Finder</h3>
          <p class="text-slate-400 text-xs leading-relaxed">Extract primary and long-tail Fiverr tags. Understand search volume tiers, competitor tags, and overall keyword difficulty ratings.</p>
        </div>

        <!-- Feature 4 -->
        <div class="bg-slate-900/40 border border-slate-800/80 rounded-2xl p-6 hover:border-emerald-500/30 transition-all group">
          <div class="w-10 h-10 rounded-xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 flex items-center justify-center mb-4 group-hover:bg-emerald-500 group-hover:text-white transition-all">
            <CheckCircle class="w-5 h-5" />
          </div>
          <h3 class="text-base font-bold text-white mb-2">Pricing & Extras Optimizer</h3>
          <p class="text-slate-400 text-xs leading-relaxed">Compare pricing tiers for your service category and experience. Find optimal upsells and extras to boost average order value.</p>
        </div>

        <!-- Feature 5 -->
        <div class="bg-slate-900/40 border border-slate-800/80 rounded-2xl p-6 hover:border-teal-500/30 transition-all group">
          <div class="w-10 h-10 rounded-xl bg-teal-500/10 border border-teal-500/20 text-teal-400 flex items-center justify-center mb-4 group-hover:bg-teal-500 group-hover:text-white transition-all">
            <Bot class="w-5 h-5" />
          </div>
          <h3 class="text-base font-bold text-white mb-2">SEO Audit & Health Score</h3>
          <p class="text-slate-400 text-xs leading-relaxed">Paste your current title, tags, and descriptions to retrieve immediate, actionable conversion checklist scores and fixes.</p>
        </div>

        <!-- Feature 6 -->
        <div class="bg-slate-900/40 border border-slate-800/80 rounded-2xl p-6 hover:border-emerald-500/30 transition-all group">
          <div class="w-10 h-10 rounded-xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 flex items-center justify-center mb-4 group-hover:bg-emerald-500 group-hover:text-white transition-all">
            <Shield class="w-5 h-5" />
          </div>
          <h3 class="text-base font-bold text-white mb-2">Safe Publish Flow</h3>
          <p class="text-slate-400 text-xs leading-relaxed">A clean UI that aids content generation and allows manual copying. Does not violate Fiverr terms of service by auto-publishing.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Pricing Section -->
  <section id="pricing" class="py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-16">
        <h2 class="text-3xl font-extrabold text-white mb-4">Pricing Built for Your Budget</h2>
        <p class="text-slate-400 text-sm">Start optimization for free and upgrade as your freelance business starts scaling up.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-5xl mx-auto">
        <!-- Tier 1 -->
        <div class="bg-slate-900/35 border border-slate-800 rounded-2xl p-8 flex flex-col justify-between">
          <div>
            <h3 class="text-lg font-bold text-white mb-2">Free Starter</h3>
            <p class="text-slate-400 text-xs mb-6">Explore tools and validate your initial Fiverr gig ideas.</p>
            <div class="text-3xl font-extrabold text-white mb-6">$0 <span class="text-xs text-slate-500 font-normal">/ forever</span></div>
            <ul class="space-y-3.5 mb-8 text-xs text-slate-300">
              <li class="flex items-center gap-2"><CheckCircle class="w-4 h-4 text-emerald-400" /> 50 Generation Credits/mo</li>
              <li class="flex items-center gap-2"><CheckCircle class="w-4 h-4 text-emerald-400" /> AI Gig Generator MVP</li>
              <li class="flex items-center gap-2"><CheckCircle class="w-4 h-4 text-emerald-400" /> 2 Saved Drafts</li>
              <li class="flex items-center gap-2"><CheckCircle class="w-4 h-4 text-emerald-400" /> Base OpenAI Model</li>
            </ul>
          </div>
          <a href="/tools/gig-generator" class="w-full py-2.5 rounded-xl border border-slate-700 text-center text-slate-200 hover:text-white hover:bg-slate-800 font-semibold text-xs transition-all">
            Get Started Free
          </a>
        </div>

        <!-- Tier 2 (Featured Pro) -->
        <div class="relative bg-slate-950 border border-emerald-500/50 rounded-2xl p-8 flex flex-col justify-between shadow-xl shadow-emerald-500/10">
          <div class="absolute -top-3.5 left-[50%] -translate-x-[50%] px-3 py-1 rounded-full bg-gradient-to-r from-emerald-600 to-teal-600 text-white text-[9px] font-bold tracking-wider uppercase border border-emerald-400/30">
            Most Popular
          </div>
          <div>
            <h3 class="text-lg font-bold text-white mb-2">Pro Freelancer</h3>
            <p class="text-slate-400 text-xs mb-6">Accelerate your workflow with full AI options, SEO audit, and premium models.</p>
            <div class="text-3xl font-extrabold text-white mb-6">$29 <span class="text-xs text-slate-500 font-normal">/ month</span></div>
            <ul class="space-y-3.5 mb-8 text-xs text-slate-300">
              <li class="flex items-center gap-2"><CheckCircle class="w-4 h-4 text-emerald-400 animate-pulse" /> 500 Generation Credits/mo</li>
              <li class="flex items-center gap-2"><CheckCircle class="w-4 h-4 text-emerald-400" /> Full Access to All 9 Modules</li>
              <li class="flex items-center gap-2"><CheckCircle class="w-4 h-4 text-emerald-400" /> Unlimited Saved Drafts & History</li>
              <li class="flex items-center gap-2"><CheckCircle class="w-4 h-4 text-emerald-400" /> Premium Models (Claude 3.5, Gemini Pro)</li>
              <li class="flex items-center gap-2"><CheckCircle class="w-4 h-4 text-emerald-400" /> Companion Chrome Extension</li>
            </ul>
          </div>
          <a href="/tools/gig-generator" class="w-full py-2.5 rounded-xl bg-gradient-to-r from-emerald-600 to-teal-600 hover:from-emerald-500 hover:to-teal-500 text-center text-white font-semibold text-xs shadow-md transition-all">
            Upgrade to Pro
          </a>
        </div>

        <!-- Tier 3 -->
        <div class="bg-slate-900/35 border border-slate-800 rounded-2xl p-8 flex flex-col justify-between">
          <div>
            <h3 class="text-lg font-bold text-white mb-2">Agency Empire</h3>
            <p class="text-slate-400 text-xs mb-6">Best for teams running multiple profiles and high-volume operations.</p>
            <div class="text-3xl font-extrabold text-white mb-6">$79 <span class="text-xs text-slate-500 font-normal">/ month</span></div>
            <ul class="space-y-3.5 mb-8 text-xs text-slate-300">
              <li class="flex items-center gap-2"><CheckCircle class="w-4 h-4 text-emerald-400" /> 2,000 Generation Credits/mo</li>
              <li class="flex items-center gap-2"><CheckCircle class="w-4 h-4 text-emerald-400" /> Up to 5 Team Seats</li>
              <li class="flex items-center gap-2"><CheckCircle class="w-4 h-4 text-emerald-400" /> Custom System Prompt Libraries</li>
              <li class="flex items-center gap-2"><CheckCircle class="w-4 h-4 text-emerald-400" /> API Access & CRM integration</li>
              <li class="flex items-center gap-2"><CheckCircle class="w-4 h-4 text-emerald-400" /> Dedicated Account Manager</li>
            </ul>
          </div>
          <a href="/tools/gig-generator" class="w-full py-2.5 rounded-xl border border-slate-700 text-center text-slate-200 hover:text-white hover:bg-slate-800 font-semibold text-xs transition-all">
            Contact Sales
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section id="faq" class="py-20 border-t border-slate-900 bg-[#0c121e]/30">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-3xl font-extrabold text-white mb-4">Frequently Asked Questions</h2>
        <p class="text-slate-400 text-sm">Have queries about how GigPilot AI boosts your freelancing? We've got answers.</p>
      </div>

      <div class="space-y-4">
        <!-- FAQ 1 -->
        <div class="bg-slate-900/40 border border-slate-800/80 rounded-xl p-5">
          <h3 class="text-sm font-bold text-white mb-2 flex items-center gap-2">
            <HelpCircle class="w-4 h-4 text-emerald-400 flex-shrink-0" /> Does GigPilot AI automatically publish Gigs on my Fiverr profile?
          </h3>
          <p class="text-slate-400 text-xs pl-6 leading-relaxed">
            No. GigPilot AI is built to keep you fully compliant with Fiverr's Terms of Service. It operates as a content generator and review assistant. You copy the content and paste it manually into the Fiverr forms.
          </p>
        </div>

        <!-- FAQ 2 -->
        <div class="bg-slate-900/40 border border-slate-800/80 rounded-xl p-5">
          <h3 class="text-sm font-bold text-white mb-2 flex items-center gap-2">
            <HelpCircle class="w-4 h-4 text-emerald-400 flex-shrink-0" /> What AI models are supported?
          </h3>
          <p class="text-slate-400 text-xs pl-6 leading-relaxed">
            We feature a multi-LLM abstraction layers that supports OpenAI (GPT-4o), Google Gemini, Anthropic Claude, Groq (for blazing fast iterations), and OpenRouter models. You can select your provider inside the workspace.
          </p>
        </div>

        <!-- FAQ 3 -->
        <div class="bg-slate-900/40 border border-slate-800/80 rounded-xl p-5">
          <h3 class="text-sm font-bold text-white mb-2 flex items-center gap-2">
            <HelpCircle class="w-4 h-4 text-emerald-400 flex-shrink-0" /> How do credits work?
          </h3>
          <p class="text-slate-400 text-xs pl-6 leading-relaxed">
            Each generation (e.g., generating a Gig description, a proposal script, or running a keyword difficulty check) consumes 1 credit. The Free tier includes 50 credits/mo, while the Pro tier refreshes to 500 credits/mo.
          </p>
        </div>

        <!-- FAQ 4 -->
        <div class="bg-slate-900/40 border border-slate-800/80 rounded-xl p-5">
          <h3 class="text-sm font-bold text-white mb-2 flex items-center gap-2">
            <HelpCircle class="w-4 h-4 text-emerald-400 flex-shrink-0" /> Can I manage multiple profiles?
          </h3>
          <p class="text-slate-400 text-xs pl-6 leading-relaxed">
            Yes, our Agency plan allows you to link multiple sub-accounts, manage templates centrally, and divide credits among your team members.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Footer Section -->
  <footer class="bg-slate-950 py-12 border-t border-slate-900 text-xs text-slate-500">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 md:grid-cols-4 gap-8 mb-8">
      <div>
        <div class="flex items-center gap-2.5 mb-4">
