---
import Layout from '../../layouts/Layout.astro';
import { Sidebar } from '../../components/Sidebar';
import { CampaignsManager } from '../../components/social/CampaignsManager';
---

<Layout title="Campaigns - Social Hub - GigPilot AI">
  <div class="flex min-h-screen bg-[#0B0F17]">
    <Sidebar currentPath="/social/campaigns" client:load />
    
    <main class="flex-1 flex flex-col min-w-0 overflow-y-auto">
      <div class="p-6 space-y-6 max-w-7xl w-full mx-auto">
        <CampaignsManager client:load />
      </div>
    </main>
  </div>
</Layout>
