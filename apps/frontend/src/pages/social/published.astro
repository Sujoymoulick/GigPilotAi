---
import Layout from '../../layouts/Layout.astro';
import { Sidebar } from '../../components/Sidebar';
import { PublishedManager } from '../../components/social/PublishedManager';
---

<Layout title="Published Posts - Social Hub - GigPilot AI">
  <div class="flex min-h-screen bg-[#F8F9FA]">
    <Sidebar currentPath="/social/published" client:load />
    
    <main class="flex-1 flex flex-col min-w-0 overflow-y-auto">
      <div class="p-6 space-y-6 max-w-7xl w-full mx-auto">
        <PublishedManager client:load />
      </div>
    </main>
  </div>
</Layout>
