---
import Layout from '../layouts/Layout.astro';
import { Sidebar } from '../components/Sidebar';
import { TemplatesManager } from '../components/TemplatesManager';
import { Library } from 'lucide-react';
---

<Layout title="Templates Manager - GigPilot AI">
  <div class="flex min-h-screen bg-[#F8F9FA]">
    {/* Sidebar Navigation */}
    <Sidebar currentPath="/templates" client:load />

    {/* Main Content Area */}
    <main class="flex-1 flex flex-col min-w-0 overflow-y-auto">
      {/* Top Navbar */}
      <header class="h-16 border-b border-slate-200 bg-white/95 backdrop-blur-md px-6 flex items-center justify-between sticky top-0 z-30 flex-shrink-0">
        <div class="flex items-center gap-2">
          <Library className="w-5 h-5 text-emerald-400" />
          <h1 class="text-sm font-bold text-slate-900">Templates Manager</h1>
        </div>
      </header>

      {/* Main Workspace */}
      <div class="flex-1">
        <TemplatesManager client:load />
      </div>
    </main>
  </div>
</Layout>
