---
import Layout from '../layouts/Layout.astro';
import { Sidebar } from '../components/Sidebar';
import { BillingManager } from '../components/BillingManager';
import { CreditCard } from 'lucide-react';
---

<Layout title="Billing & Plans - GigPilot AI">
  <div class="flex min-h-screen bg-[#0B0F17]">
    {/* Sidebar Navigation */}
    <Sidebar currentPath="/billing" client:load />

    {/* Main Content Area */}
    <main class="flex-1 flex flex-col min-w-0 overflow-y-auto">
      <header class="h-16 border-b border-slate-800/80 bg-slate-950/40 backdrop-blur-md px-6 flex items-center justify-between sticky top-0 z-30 flex-shrink-0">
        <div class="flex items-center gap-2">
          <CreditCard className="w-5 h-5 text-emerald-400" />
          <h1 class="text-sm font-bold text-white">Billing & Plans</h1>
        </div>
      </header>

      {/* Main Workspace */}
      <div class="flex-1">
        <BillingManager client:load />
      </div>
    </main>
  </div>
</Layout>
